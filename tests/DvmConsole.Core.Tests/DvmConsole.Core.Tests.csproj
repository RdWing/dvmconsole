<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DvmConsole.Core.Tests</RootNamespace>
    <AssemblyName>DvmConsole.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Same YamlDotNet version pinned by dvmconsole/DVMConsole.csproj (16.2.0),
         required by the YamlMember attributes in the linked Codeplug.cs. -->
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Link the production Codeplug source directly (no ProjectReference to the
      WPF dvmconsole project) so this suite runs headless on net8.0/Linux, the
      same pattern as tests/DvmConsole.Vocoder.Tests. Codeplug.cs depends on
      fnecore.P25.P25Defines (linked below), YamlDotNet, and the production
      dvmconsole.RadioAlias type, which is provided by ProductionStubs.cs in
      this project.
    -->
    <Compile Include="..\..\dvmconsole\Codeplug.cs" Link="Codeplug.cs" />
    <Compile Include="..\..\fnecore\P25\P25Defines.cs" Link="P25Defines.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deterministic YAML fixture for the schema gate; copied to the test
         output directory so CodeplugSchemaTests can load it via
         AppContext.BaseDirectory. -->
    <None Update="Fixtures\minimal_codeplug.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
