<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DvmConsole.Core.Tests</RootNamespace>
    <AssemblyName>DvmConsole.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Same YamlDotNet version pinned by dvmconsole/DVMConsole.csproj (16.2.0),
         required by the YamlMember attributes in the Core-owned Codeplug.cs. -->
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
    <!-- Same Newtonsoft.Json version pinned by dvmconsole/DVMConsole.csproj (13.0.3),
         required by the JsonIgnore attributes on the Core-owned settings test models. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Same NWaves version pinned by dvmconsole/DVMConsole.csproj (0.9.6),
         required by the STFT used in the Core-owned MBEToneDetector. -->
    <PackageReference Include="NWaves" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DvmConsole.Core\DvmConsole.Core.csproj" />
    <!-- Platform contract gate: fake-driven contract tests (PlatformContractTests.cs)
         lock the DvmConsole.Platform abstraction surface (audio, dialogs, hotkeys,
         native probe, composition) before any native adapter exists. -->
    <ProjectReference Include="..\..\DvmConsole.Platform\DvmConsole.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deterministic YAML fixture for the schema gate; copied to the test
         output directory so CodeplugSchemaTests can load it via
         AppContext.BaseDirectory. -->
    <None Update="Fixtures\minimal_codeplug.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
