<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DvmConsole.Vocoder.Tests</RootNamespace>
    <AssemblyName>DvmConsole.Vocoder.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Link the production interop source directly (no ProjectReference to the WPF
      dvmconsole project) so this suite runs headless on net8.0/Linux. The linked
      file must self-contain every type it references; the one type it cannot
      reach (VocoderToneLookupTable) comes from the DvmConsole.Core
      ProjectReference below, and the unused `using fnecore;` is inert because no
      fnecore type is referenced.
    -->
    <Compile Include="..\..\dvmconsole\VocoderInterop.cs" Link="VocoderInterop.cs" />
    <Compile Include="..\..\dvmconsole\VocoderLibraryProbe.cs" Link="VocoderLibraryProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Portable dvmconsole.VocoderToneLookupTable (72-entry IMBE tone table),
         consumed by the linked VocoderInterop.cs MBEToneGenerator. Core is
         net8.0 so it builds headless on Linux. -->
    <ProjectReference Include="..\..\DvmConsole.Core\DvmConsole.Core.csproj" />
  </ItemGroup>

</Project>
