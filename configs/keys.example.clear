keys:
  -
    protocol: "p25"
    # The key ID, in hex, for this key
    keyId: 0x1
    # The algorithm ID, in hex, for this key
    algId: 0x84
    # The key material, as a hex string representation, for this key
    key: "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F"
  -
    protocol: "p25"
    # The key ID, in hex, for this key
    keyId: 0x2
    # The algorithm ID, in hex, for this key
    algId: 0xAA
    # The key material, as a hex string representation, for this key
    key: "0011223344"
  -
    # DMR Association AES-256 privacy (algorithm 0x05)
    protocol: "dmr"
    keyId: 0x03
    algId: 0x05
    key: "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F"
  -
    # NXDN EHR voice scrambling (cipher type 0x01, 15-bit non-zero seed)
    protocol: "nxdn"
    keyId: 0x04
    algId: 0x01
    key: "1234"
