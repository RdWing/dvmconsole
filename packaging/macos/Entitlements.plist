<!--
  Digital Voice Modem - Desktop Dispatch Console (Avalonia Shell)
  AGPLv3 Open Source. Use is subject to license terms.

  Hardened-runtime entitlements for the Developer ID-signed bundle.

  A .NET (CoreCLR) app under the hardened runtime needs:
    - allow-jit                       JIT + dynamic codegen (CoreCLR)
    - allow-unsigned-executable-memory  CoreCLR executable-heap allocation
    - allow-dyld-environment-variables DYLD_* passthrough (tests/smokes)
    - disable-library-validation     REQUIRED by .NET host libraries
      (libhostfxr.dylib etc. fail the team-ID check under hardened
      runtime without it — verified: a hardened-runtime signed bundle
      without this entitlement fails at launch with "mapping process
      and mapped file (non-platform) have different Team IDs"; with
      it, the signed bundle launches). This is the documented .NET
      distribution guidance for hardened runtime.
  The bundled native libvocoder.dylib is signed along with the app.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
