#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
BUNDLED_APPHOST="$SCRIPT_DIR/../Resources/publish/DvmConsole.Desktop"
if [ -x "$BUNDLED_APPHOST" ]; then
    exec "$BUNDLED_APPHOST" "$@"
fi

DOTNET_COMMAND="${DVM_DOTNET:-dotnet}"
exec "$DOTNET_COMMAND" "$SCRIPT_DIR/../Resources/publish/DvmConsole.Desktop.dll" "$@"
