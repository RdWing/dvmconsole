<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <!-- Keep the mixed upstream/owned project under the standard analyzer
         baseline; only the finite upstream compatibility list below is exempt. -->
    <AnalysisMode>Minimum</AnalysisMode>
    <!-- The pinned upstream sources still use these legacy framework APIs and
         predate the SDK's minimum quality rules. Keep this finite compatibility
         list visible instead of disabling analysis for the whole mixed project. -->
    <NoWarn>$(NoWarn);CS0672;SYSLIB0003;SYSLIB0021;SYSLIB0023;SYSLIB0051;CA1507;CA1510;CA1512;CA1822;CA1825;CA1829;CA1834;CA1850;CA2208;CA2211</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>fnecore</RootNamespace>
    <AssemblyName>DvmConsole.Fne</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile only the upstream runtime surface used by the console. The
         command-line parser and semantic-version utility are standalone host
         concerns and pull reflection/serialization roots into the linker. -->
    <Compile Include="../../fnecore/**/*.cs"
             Exclude="../../fnecore/obj/**/*.cs;../../fnecore/bin/**/*.cs;../../fnecore/Udp.cs;../../fnecore/Properties/AssemblyInfo.cs;../../fnecore/Utility/CommandOptions.cs;../../fnecore/Utility/SemVersion.cs" />
    <Compile Include="CompatibleUdp.cs" />
    <Compile Include="FneInboundFramePolicy.cs" />
    <Compile Include="FneTalkgroupAnnouncement.cs" />
    <Compile Include="FnePeerKeepaliveStreamInitializer.cs" />
    <Compile Include="FneTransportCryptoCodec.cs" />
    <Compile Include="FneTransportNegotiationState.cs" />
    <Compile Include="InboundReplayWindow.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
</Project>
