<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <!-- The pinned upstream sources still use these legacy framework APIs. -->
    <NoWarn>$(NoWarn);CS0672;SYSLIB0003;SYSLIB0021;SYSLIB0023;SYSLIB0051</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>fnecore</RootNamespace>
    <AssemblyName>DvmConsole.Fne</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../fnecore/**/*.cs" Exclude="../../fnecore/obj/**/*.cs;../../fnecore/bin/**/*.cs;../../fnecore/Udp.cs" />
    <Compile Include="CompatibleUdp.cs" />
    <Compile Include="FneInboundFramePolicy.cs" />
    <Compile Include="FneTransportCryptoCodec.cs" />
    <Compile Include="FneTransportNegotiationState.cs" />
    <Compile Include="InboundReplayWindow.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
</Project>
