<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="using:DvmConsole.Presentation">
  <!-- TextBlock inherits its owning control's size. A global TextBlock setter
       would override the compact card buttons' inherited template font size. -->
  <Style Selector=":is(TemplatedControl)">
    <Setter Property="FontSize" Value="{DynamicResource MobileBodyFontSize}" />
  </Style>
  <Style Selector="presentation|ChannelCardContent Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="{DynamicResource ChannelListDetailFontSize}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.card-listen">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"/>
      </ControlTemplate>
    </Setter>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.card-listen:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource OperationalSelectionBorderBrush}"/>
  </Style>
  <Style Selector=":is(Slider).touch-slider /template/ Thumb">
    <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
    <Setter Property="Template">
      <ControlTemplate><Border Background="#0789FF" CornerRadius="12"/></ControlTemplate>
    </Setter>
  </Style>
</Styles>
