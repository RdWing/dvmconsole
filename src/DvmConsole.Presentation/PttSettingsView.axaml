<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="using:DvmConsole.Presentation"
             x:Class="DvmConsole.Presentation.PttSettingsView"
             x:DataType="presentation:IPttSettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Button"><Setter Property="MinHeight" Value="44"/></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="44"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="44"/></Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PttSettingsScroller" Margin="10">
    <StackPanel Spacing="12">
      <TextBlock Classes="heading" Text="Global PTT Settings"/>
      <TextBlock Classes="caption"
                 Text="Hardware PTT inputs operate every channel selected with TX. Active-system PTT limits selected channels to the system that is active when PTT starts."
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasHardwarePttCapabilities}"/>
      <TextBlock Classes="caption"
                 Text="No hardware PTT input is available on this device. On-screen channel PTT remains available."
                 TextWrapping="Wrap"
                 IsVisible="{Binding !HasHardwarePttCapabilities}"/>
      <Border Classes="panel" IsVisible="{Binding IsKeyboardPttCapabilityAvailable}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="Keyboard PTT"/>
          <WrapPanel ItemSpacing="12" LineSpacing="8">
            <StackPanel Width="220" Spacing="2">
              <TextBlock Text="Global PTT key"/>
              <ComboBox ItemsSource="{Binding KeyboardPttKeyOptions}"
                        SelectedItem="{Binding SelectedGlobalPttKeyName, Mode=TwoWay}"
                        AutomationProperties.Name="Global PTT key"/>
            </StackPanel>
            <Button Content="Apply global key"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Apply global PTT key"
                    Click="HandleApplyGlobalKeyClick"/>
          </WrapPanel>
          <WrapPanel ItemSpacing="12" LineSpacing="8">
            <StackPanel Width="220" Spacing="2">
              <TextBlock Text="Active-system PTT key"/>
              <ComboBox ItemsSource="{Binding KeyboardPttKeyOptions}"
                        SelectedItem="{Binding SelectedActiveSystemPttKeyName, Mode=TwoWay}"
                        AutomationProperties.Name="Active-system PTT key"/>
            </StackPanel>
            <Button Content="Apply active-system key"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Apply active-system PTT key"
                    Click="HandleApplyActiveSystemKeyClick"/>
          </WrapPanel>
          <CheckBox Content="Toggle keyboard PTT instead of hold-to-talk"
                    IsChecked="{Binding TogglePttMode, Mode=TwoWay}"
                    AutomationProperties.Name="Toggle keyboard PTT mode"/>
          <Button Content="Request macOS keyboard access"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding IsKeyboardPermissionRequestAvailable}"
                  AutomationProperties.Name="Request keyboard access"
                  Click="HandleRequestKeyboardPermissionClick"/>
          <TextBlock Classes="caption"
                     Text="Each keyboard key must be unique. Both bindings use the same hold-to-talk or toggle mode."
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Classes="panel" IsVisible="{Binding IsSerialPttCapabilityAvailable}">
        <StackPanel Spacing="10">
          <TextBlock FontWeight="SemiBold" Text="Serial hardware PTT"/>
          <CheckBox Content="Enable serial hardware PTT"
                    IsChecked="{Binding SerialPttEnabled, Mode=TwoWay}"
                    AutomationProperties.Name="Enable serial hardware PTT"/>
          <CheckBox Content="Limit serial PTT to TX-selected resources in the active system"
                    IsChecked="{Binding SerialPttActiveSystemOnly, Mode=TwoWay}"
                    IsEnabled="{Binding SerialPttEnabled}"
                    AutomationProperties.Name="Limit serial PTT to active system"/>
          <WrapPanel ItemSpacing="12" LineSpacing="8">
            <StackPanel Width="240" Spacing="2">
              <TextBlock Text="Device"/>
              <ComboBox ItemsSource="{Binding SerialPttPortOptions}"
                        SelectedItem="{Binding SerialPttPortName, Mode=TwoWay}"
                        IsEnabled="{Binding SerialPttEnabled}"
                        AutomationProperties.Name="Serial PTT device"/>
            </StackPanel>
            <StackPanel Width="160" Spacing="2">
              <TextBlock Text="Baud"/>
              <ComboBox ItemsSource="{Binding SerialPttBaudRates}"
                        SelectedItem="{Binding SerialPttBaudRate, Mode=TwoWay}"
                        IsEnabled="{Binding SerialPttEnabled}"
                        AutomationProperties.Name="Serial PTT baud rate"/>
            </StackPanel>
          </WrapPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Refresh devices"
                    AutomationProperties.Name="Refresh serial PTT devices"
                    Click="HandleRefreshSerialDevicesClick"/>
            <Button Content="Apply"
                    AutomationProperties.Name="Apply serial PTT settings"
                    Click="HandleApplySerialSettingsClick"/>
          </WrapPanel>
          <TextBlock Text="{Binding SerialPttStatusText}" TextWrapping="Wrap"/>
          <TextBlock Classes="caption"
                     Text="The device must send one state per line: on, 1, pressed, or ptt=on to key; off, 0, released, or ptt=off to release. Device removal always releases PTT."
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
