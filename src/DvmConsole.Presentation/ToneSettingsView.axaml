<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="using:DvmConsole.Presentation"
             x:Class="DvmConsole.Presentation.ToneSettingsView"
             x:DataType="presentation:IToneSettingsViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://DvmConsole.Presentation/CompactSettingsStyles.axaml" />
    <Style Selector="ListBox.preset-library > ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.subtle-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <StackPanel Margin="10,10,10,0" Spacing="8">
      <TextBlock Classes="heading" Text="Tones and DTMF" />
      <WrapPanel ItemSpacing="6" LineSpacing="6">
        <Button Content="DTMF" Tag="DtmfSection" AutomationProperties.Name="Go to DTMF" Click="HandleSectionClick" />
        <Button Content="Patterns" Tag="TonePatternSection" AutomationProperties.Name="Go to tone patterns" Click="HandleSectionClick" />
        <Button x:Name="customAudioSectionLink" Content="Custom audio" Tag="CustomAudioSection" AutomationProperties.Name="Go to custom audio" Click="HandleSectionClick" />
        <Button Content="QCII paging" Tag="PagingSection" AutomationProperties.Name="Go to QCII paging" Click="HandleSectionClick" />
      </WrapPanel>
    </StackPanel>
    <ScrollViewer x:Name="ToneSettingsScroller" Grid.Row="1" Margin="10" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <Border x:Name="DtmfSection" Classes="panel">
          <StackPanel Spacing="8">
            <WrapPanel ItemSpacing="12" LineSpacing="4">
              <TextBlock FontWeight="SemiBold" Text="DTMF" />
              <TextBlock Classes="caption" Text="{Binding AlertTargetSummary}"
                         ToolTip.Tip="{Binding AlertTargetDetails}" AutomationProperties.HelpText="{Binding AlertTargetDetails}" />
            </WrapPanel>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <TextBox Width="180"
                       Watermark="Digits"
                       Text="{Binding DtmfDigits, Mode=TwoWay}"
                       AutomationProperties.Name="DTMF digits"/>
              <Button Content="Send"
                      Command="{Binding SendDtmfCommand}"
                      ScrollViewer.BringIntoViewOnFocusChange="False"
                      AutomationProperties.Name="Send DTMF to ALERT channels"/>
              <TextBox Width="200"
                       Watermark="Preset name"
                       Text="{Binding DtmfPresetName, Mode=TwoWay}"
                       AutomationProperties.Name="DTMF preset name"/>
              <Button Content="Save preset"
                      Command="{Binding SaveDtmfPresetCommand}"
                      AutomationProperties.Name="Save DTMF preset"/>
            </WrapPanel>
            <TextBox Width="300"
                     HorizontalAlignment="Left"
                     Watermark="Filter DTMF presets"
                     AutomationProperties.Name="Filter DTMF presets"
                     IsVisible="{Binding IsDtmfPresetFilterVisible}"
                     Text="{Binding DtmfPresetFilterText, Mode=TwoWay}"/>
            <ListBox x:Name="dtmfPresetList" Classes="preset-library" MaxHeight="240"
                     ItemsSource="{Binding FilteredDtmfPresets}" AutomationProperties.Name="Saved DTMF presets"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     AutoScrollToSelectedItem="False" ScrollViewer.BringIntoViewOnFocusChange="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="presentation:IDtmfPresetViewModel">
                  <Grid Classes="tone-preset-row" SizeChanged="HandlePresetRowSizeChanged" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="6">
                      <Button Content="Load" Tag="{Binding}" AutomationProperties.Name="Load DTMF preset into editor" Click="HandleUseDtmfPresetClick"/>
                      <Button Content="Send" Tag="{Binding}" ScrollViewer.BringIntoViewOnFocusChange="False" AutomationProperties.Name="Send DTMF preset to ALERT channels" Click="HandleSendDtmfPresetClick"/>
                      <Button Classes="subtle-action" Content="Delete" Tag="{Binding}" AutomationProperties.Name="Delete DTMF preset" Click="HandleDeleteDtmfPresetClick"/>
                    </WrapPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
        <Border x:Name="TonePatternSection" Classes="panel">
          <StackPanel Spacing="8">
            <WrapPanel ItemSpacing="12" LineSpacing="4">
              <TextBlock FontWeight="SemiBold" Text="Alert / QCII tone pattern" />
              <TextBlock Classes="caption" Text="{Binding AlertTargetSummary}"
                         ToolTip.Tip="{Binding AlertTargetDetails}" AutomationProperties.HelpText="{Binding AlertTargetDetails}" />
            </WrapPanel>
            <TextBlock Classes="caption"
                       Text="Build an ordered pattern of 300 to 2500 Hz tones and silent holds. Every step remains in one call."
                       TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="92,110,110,*" ColumnSpacing="8" Margin="0,0,0,-3">
              <TextBlock Grid.Column="1" Classes="caption" Text="Frequency"/>
              <TextBlock Grid.Column="2" Classes="caption" Text="Duration (sec)"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding ToneSequenceSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="presentation:IToneSequenceStepViewModel">
                  <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,3">
                    <CheckBox Content="Silence"
                              IsChecked="{Binding IsSilence, Mode=TwoWay}"
                              AutomationProperties.Name="Silent tone step"/>
                    <TextBox Width="110"
                             Watermark="300 to 2500 Hz"
                             Text="{Binding FrequencyText, Mode=TwoWay}"
                             AutomationProperties.Name="Tone step frequency"/>
                    <TextBox Width="110"
                             Watermark="Seconds"
                             Text="{Binding DurationText, Mode=TwoWay}"
                             AutomationProperties.Name="Tone step duration"/>
                    <Button Content="↑" Tag="{Binding}" AutomationProperties.Name="Move tone step up" Click="HandleMoveToneStepUpClick"/>
                    <Button Content="↓" Tag="{Binding}" AutomationProperties.Name="Move tone step down" Click="HandleMoveToneStepDownClick"/>
                    <Button Content="Remove" Tag="{Binding}" AutomationProperties.Name="Remove tone step" Click="HandleRemoveToneStepClick"/>
                  </WrapPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="Add tone" AutomationProperties.Name="Add tone step" Click="HandleAddToneStepClick"/>
              <Button Content="Add silence" AutomationProperties.Name="Add silent tone step" Click="HandleAddSilenceStepClick"/>
              <Button Content="Send" Command="{Binding SendToneCommand}" ScrollViewer.BringIntoViewOnFocusChange="False" AutomationProperties.Name="Send tone pattern to ALERT channels"/>
              <TextBox Width="200"
                       Watermark="Preset name"
                       Text="{Binding TonePresetName, Mode=TwoWay}"
                       AutomationProperties.Name="Tone preset name"/>
              <Button Content="Save preset" Command="{Binding SaveTonePresetCommand}" AutomationProperties.Name="Save tone preset"/>
            </WrapPanel>
            <TextBox Width="300"
                     HorizontalAlignment="Left"
                     Watermark="Filter tone presets"
                     AutomationProperties.Name="Filter tone presets"
                     IsVisible="{Binding IsTonePresetFilterVisible}"
                     Text="{Binding TonePresetFilterText, Mode=TwoWay}"/>
            <ListBox x:Name="tonePresetList" Classes="preset-library" MaxHeight="240"
                     ItemsSource="{Binding FilteredTonePresets}" AutomationProperties.Name="Saved tone patterns"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     AutoScrollToSelectedItem="False" ScrollViewer.BringIntoViewOnFocusChange="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="presentation:ITonePresetViewModel">
                  <Grid Classes="tone-preset-row" SizeChanged="HandlePresetRowSizeChanged" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,3">
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Grid.Column="1" ItemSpacing="8" LineSpacing="8">
                      <Button Content="Load" Tag="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Load {0} into editor'}" Click="HandleUseTonePresetClick"/>
                      <Button Content="Send" Tag="{Binding}" ScrollViewer.BringIntoViewOnFocusChange="False" AutomationProperties.Name="{Binding Name, StringFormat='Send {0} to ALERT channels'}" Click="HandleSendTonePresetClick"/>
                      <Button Classes="subtle-action" Content="Delete" Tag="{Binding}" AutomationProperties.Name="Delete tone preset" Click="HandleDeleteTonePresetClick"/>
                    </WrapPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
        <Border x:Name="PagingSection" Classes="panel">
          <StackPanel Spacing="8">
            <WrapPanel ItemSpacing="12" LineSpacing="4">
              <TextBlock FontWeight="SemiBold" Text="Quick Call II / page" />
              <TextBlock Classes="caption" Text="{Binding PageTargetSummary}"
                         ToolTip.Tip="{Binding PageTargetDetails}" AutomationProperties.HelpText="{Binding PageTargetDetails}" />
            </WrapPanel>
            <TextBlock Classes="caption"
                       Text="Tone A is sent for 1 second, then tone B for 3 seconds in the same call. Frequencies must be 300–2500 Hz. Arm PAGE on the channel cards to choose targets; PAGE clears after a successful send."
                       TextWrapping="Wrap"/>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <TextBox Width="110" Watermark="Tone A Hz" Text="{Binding QuickCallToneAText, Mode=TwoWay}" AutomationProperties.Name="Quick Call tone A"/>
              <TextBox Width="110" Watermark="Tone B Hz" Text="{Binding QuickCallToneBText, Mode=TwoWay}" AutomationProperties.Name="Quick Call tone B"/>
              <Button Content="Send" ScrollViewer.BringIntoViewOnFocusChange="False" AutomationProperties.Name="Send Quick Call page to PAGE channels" Click="HandleSendQuickCallClick"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border x:Name="CustomAudioSection" Classes="panel">
          <StackPanel Spacing="8">
            <WrapPanel ItemSpacing="12" LineSpacing="4">
              <TextBlock FontWeight="SemiBold" Text="Custom audio" />
              <TextBlock Classes="caption" Text="{Binding AlertTargetSummary}"
                         ToolTip.Tip="{Binding AlertTargetDetails}" AutomationProperties.HelpText="{Binding AlertTargetDetails}" />
            </WrapPanel>
            <TextBlock Classes="caption"
                       Text="Import PCM WAV, MPEG/MP3, or Ogg Opus audio up to 30 seconds."
                       TextWrapping="Wrap"/>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <TextBox Width="240"
                       Watermark="Display name (optional)"
                       Text="{Binding AlertToneNameText, Mode=TwoWay}"
                       AutomationProperties.Name="Alert audio display name"/>
              <Button Content="Import audio…" AutomationProperties.Name="Import alert audio" Click="HandleImportAlertToneClick"/>
            </WrapPanel>
            <TextBox Width="300"
                     HorizontalAlignment="Left"
                     Watermark="Filter custom audio"
                     AutomationProperties.Name="Filter custom audio"
                     IsVisible="{Binding IsAlertToneFilterVisible}"
                     Text="{Binding AlertToneFilterText, Mode=TwoWay}"/>
            <ListBox x:Name="customAudioList" Classes="preset-library" MaxHeight="240"
                     ItemsSource="{Binding FilteredAlertTones}" AutomationProperties.Name="Custom audio"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     AutoScrollToSelectedItem="False" ScrollViewer.BringIntoViewOnFocusChange="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="presentation:IAlertToneViewModel">
                  <Grid Classes="tone-preset-row" SizeChanged="HandlePresetRowSizeChanged" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,3">
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Grid.Column="1" ItemSpacing="8" LineSpacing="8">
                      <Button Content="Send" Tag="{Binding}" ScrollViewer.BringIntoViewOnFocusChange="False" AutomationProperties.Name="{Binding Name, StringFormat='Send {0} to ALERT channels'}" Click="HandleSendAlertToneClick"/>
                      <Button Classes="subtle-action" Content="Delete" Tag="{Binding}" AutomationProperties.Name="Delete alert audio" Click="HandleDeleteAlertToneClick"/>
                    </WrapPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
        <TextBlock Classes="caption"
                   Text="DTMF, generated tones, presets, and custom audio transmit to all ALERT-armed channels. QCII transmits to all PAGE-armed channels."
                   TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
