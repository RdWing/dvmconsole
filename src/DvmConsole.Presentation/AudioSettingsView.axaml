<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="using:DvmConsole.Presentation"
             x:Class="DvmConsole.Presentation.AudioSettingsView"
             x:DataType="presentation:IAudioSettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Button"><Setter Property="MinHeight" Value="44"/></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="44"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="44"/></Style>
    <Style Selector="Slider"><Setter Property="MinHeight" Value="44"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="44"/></Style>
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <TextBlock Classes="heading" Text="Audio Settings" />
    <WrapPanel ItemSpacing="12" LineSpacing="8">
      <StackPanel Width="300" Spacing="4">
        <TextBlock Text="Input device" />
        <ComboBox ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDevice, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="presentation:IAudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Width="300" Spacing="4">
        <TextBlock Text="Output device" />
        <ComboBox ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="presentation:IAudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Content="Refresh devices" AutomationProperties.Name="Refresh audio devices" Command="{Binding RefreshAudioDevicesCommand}" />
      <Button Content="Test talk permit tone" AutomationProperties.Name="Test talk permit tone" Click="HandleTestPermitToneClick" />
      <Button Content="Request microphone access"
              AutomationProperties.Name="Request microphone access"
              Click="HandleRequestMicrophonePermissionClick"
              IsVisible="{Binding IsMicrophonePermissionRequestAvailable}" />
    </WrapPanel>

    <Border Classes="panel">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="RX audio processing options" />
        <TextBlock Classes="caption" Text="Configure each decoded digital voice mode independently." TextWrapping="Wrap" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="125,44,116,44,116,116,44,116,116,116" ColumnSpacing="6">
              <TextBlock Text="Mode" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="HPF" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="HPF Hz" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="Peak" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="Peak Hz" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="5" Text="Peak dB" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="6" Text="Comp" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="7" Text="Ratio" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="8" Text="Thresh dBFS" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="9" Text="Makeup dB" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding RxAudioProcessingModes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="presentation:IRxAudioProcessingModeViewModel">
                  <Grid ColumnDefinitions="125,44,116,44,116,116,44,116,116,116" ColumnSpacing="6" Margin="0,2">
                    <TextBlock Text="{Binding ModeName}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding HighPassFilterEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                    <NumericUpDown Grid.Column="2" Minimum="0" Maximum="500" Increment="25" FormatString="0" ClipValueToMinMax="True" Value="{Binding HighPassFrequencyHz, Mode=TwoWay}" IsEnabled="{Binding HighPassFilterEnabled}" />
                    <CheckBox Grid.Column="3" IsChecked="{Binding PeakingFilterEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                    <NumericUpDown Grid.Column="4" Minimum="250" Maximum="3000" Increment="25" FormatString="0" ClipValueToMinMax="True" Value="{Binding PeakingFrequencyHz, Mode=TwoWay}" IsEnabled="{Binding PeakingFilterEnabled}" />
                    <NumericUpDown Grid.Column="5" Minimum="-10" Maximum="10" Increment="0.5" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding PeakingGainDb, Mode=TwoWay}" IsEnabled="{Binding PeakingFilterEnabled}" />
                    <CheckBox Grid.Column="6" IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                    <NumericUpDown Grid.Column="7" Minimum="1" Maximum="10" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding CompressorRatio, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}" />
                    <NumericUpDown Grid.Column="8" Minimum="-40" Maximum="0" Increment="1" FormatString="0" ClipValueToMinMax="True" Value="{Binding CompressorThresholdDbfs, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}" />
                    <NumericUpDown Grid.Column="9" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding CompressorMakeupGainDb, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Apply RX options" AutomationProperties.Name="Apply receive audio processing options" Command="{Binding ApplyRxAudioProcessingOptionsCommand}" />
          <TextBlock Classes="caption" Text="Defaults: 250 Hz HPF, 2.5 kHz / +3 dB peak, compressor off (3:1, -18 dBFS, +3 dB when enabled)." VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="panel">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="Microphone processing" />
        <TextBlock Classes="caption"
                   Text="DVM Console processing is the standard macOS microphone path. It avoids the additional Apple full-duplex processing latency while retaining console gain, EQ, and optional AGC."
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsAppleVoiceProcessingPlatformAvailable}" />
        <Grid ColumnDefinitions="Auto,260,*" ColumnSpacing="8" IsVisible="{Binding !IsAppleVoiceProcessingPlatformAvailable}">
          <TextBlock Text="Mode" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding AudioProcessingModeOptions}" SelectedItem="{Binding SelectedAudioProcessingMode, Mode=TwoWay}" />
        </Grid>
        <TextBlock Classes="caption" Text="{Binding AudioProcessingDescription}" TextWrapping="Wrap" IsVisible="{Binding !IsAppleVoiceProcessingPlatformAvailable}" />
        <WrapPanel ItemSpacing="16" LineSpacing="8" IsEnabled="{Binding IsDvmConsoleProcessingSelected}">
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Gain" VerticalAlignment="Center" /><NumericUpDown x:Name="MicrophoneGain" Width="116" Minimum="0.25" Maximum="3.0" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding AudioInputGainText, Mode=TwoWay}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Low dB" VerticalAlignment="Center" /><NumericUpDown x:Name="MicrophoneLowGain" Width="116" Minimum="-12" Maximum="12" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding AudioInputLowGainText, Mode=TwoWay}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Mid dB" VerticalAlignment="Center" /><NumericUpDown x:Name="MicrophoneMidGain" Width="116" Minimum="-12" Maximum="12" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding AudioInputMidGainText, Mode=TwoWay}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="High dB" VerticalAlignment="Center" /><NumericUpDown x:Name="MicrophoneHighGain" Width="116" Minimum="-12" Maximum="12" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding AudioInputHighGainText, Mode=TwoWay}" /></StackPanel>
        </WrapPanel>
        <WrapPanel ItemSpacing="10" LineSpacing="8">
          <CheckBox Content="Automatic gain control" IsChecked="{Binding AudioInputAgcEnabled, Mode=TwoWay}" IsEnabled="{Binding IsDvmConsoleProcessingSelected}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsAgcTargetEnabled}"><TextBlock Text="AGC target (dBFS)" VerticalAlignment="Center" /><NumericUpDown x:Name="MicrophoneAgcTarget" Width="136" Minimum="-40" Maximum="-12" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding AudioInputAgcTargetDbfsText, Mode=TwoWay}" /></StackPanel>
          <CheckBox Content="Keep transmit microphone warm" IsChecked="{Binding KeepTransmitMicrophoneWarm, Mode=TwoWay}" />
          <Button Content="Apply" AutomationProperties.Name="Apply microphone processing settings" Command="{Binding ApplyAudioInputSettingsCommand}" />
        </WrapPanel>
        <TextBlock Classes="caption" Text="The default AGC target is -25 dBFS. Use a more-negative value for a quieter target; accepted range is -40 to -12 dBFS." TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="Bluetooth PTT uses the optimized DVM Console audio path. Most headsets should not need Keep Mic Warm; enable it only if a particular headset still has unacceptable cold-start delay, because it may lower output audio quality while enabled." TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Classes="panel">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="Microphone presets" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <TextBox Width="240" Watermark="Preset name" Text="{Binding AudioInputPresetNameText, Mode=TwoWay}" />
          <Button Content="Save current" AutomationProperties.Name="Save current microphone preset" Click="HandleSavePresetClick" />
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding AudioInputPresets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="presentation:IAudioInputPresetViewModel">
              <Border Classes="panel">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Use" AutomationProperties.Name="Use microphone preset" Tag="{Binding}" Click="HandleUsePresetClick" />
                  <Button Grid.Column="2" Content="Delete" AutomationProperties.Name="Delete microphone preset" Tag="{Binding}" Click="HandleDeletePresetClick" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="panel">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="Per-channel output routes"/>
        <TextBlock Classes="caption"
                   Text="Each channel follows the main output device above. Choose a different device only for an explicit channel override. Balance places RX audio from left through center to right and applies immediately."
                   TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding AudioRouteSystems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="presentation:IChannelAudioRouteSystemViewModel">
              <StackPanel Spacing="4" Margin="0,2,0,6">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding AudioRouteChannels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="presentation:IChannelAudioRouteViewModel">
                      <Border Classes="panel audio-route-row" Margin="0,0,0,4" Padding="8,4">
                        <WrapPanel ItemSpacing="10" LineSpacing="6">
                          <TextBlock Width="170"
                                     Text="{Binding Name}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                          <ComboBox Width="220"
                                    ItemsSource="{Binding OutputDeviceOptions}"
                                    SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                    AutomationProperties.Name="Channel output device">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="presentation:IAudioDeviceOptionViewModel">
                                <TextBlock Text="{Binding DisplayName}"/>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <presentation:NeutralSnapSlider Width="180"
                                                          Minimum="-1"
                                                          Maximum="1"
                                                          NeutralValue="0"
                                                          TickFrequency="0.1"
                                                          Value="{Binding StereoBalance, Mode=TwoWay}"
                                                          ToolTip.Tip="Stereo balance: -1 left, 0 center, +1 right"
                                                          AutomationProperties.Name="Channel stereo balance"/>
                          <TextBlock Width="58"
                                     Text="{Binding StereoBalanceText}"
                                     VerticalAlignment="Center"/>
                          <Button Content="Save route"
                                  Tag="{Binding}"
                                  AutomationProperties.Name="Save channel output route"
                                  Click="HandleSaveChannelRouteClick"/>
                        </WrapPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
