<UserControl
    x:Class="DvmConsole.Presentation.ChannelCardContent"
    x:Name="CardContentRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:DvmConsole.Presentation"
    x:DataType="presentation:IChannelCardViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://DvmConsole.Presentation/CompactSliderStyles.axaml" />
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,24" RowSpacing="3">
    <StackPanel Spacing="2">
      <TextBlock
          Foreground="{Binding CardTextBrush}"
          FontWeight="Bold"
          FontSize="{Binding UiFontSize, ElementName=CardContentRoot}"
          Text="{Binding Name}"
          TextTrimming="CharacterEllipsis" />
      <TextBlock
          Foreground="{Binding CardTextBrush}"
          FontSize="{Binding UiSmallFontSize, ElementName=CardContentRoot}"
          Text="{Binding TalkgroupText}" />
    </StackPanel>
    <TextBlock
        Grid.Row="1"
        Foreground="{Binding CardTextBrush}"
        FontSize="{Binding UiSmallFontSize, ElementName=CardContentRoot}"
        Text="{Binding LastCallerDisplayText}"
        TextTrimming="CharacterEllipsis"
        VerticalAlignment="Center" />
    <presentation:AudioLevelMeter
        Grid.Row="2"
        Classes="channel-audio-meter"
        Width="{Binding AudioMeterWidth}"
        Height="4"
        Meter="{Binding AudioMeter}"
        HorizontalAlignment="Center"
        AutomationProperties.Name="Channel audio level" />
    <Grid Grid.Row="3" MinHeight="23" ClipToBounds="False" ColumnDefinitions="*,Auto" ColumnSpacing="4">
      <presentation:NeutralSnapSlider
          Classes="compact-slider"
          Minimum="-1"
          Maximum="1"
          NeutralValue="0"
          Value="{Binding VolumeSliderValue, Mode=TwoWay}"
          VerticalAlignment="Center"
          ToolTip.Tip="Channel gain: center is 0 dB (1×)"
          AutomationProperties.Name="{Binding VolumeAutomationName}"
          AutomationProperties.HelpText="Channel gain; center is 0 decibels." />
      <Button
          Grid.Column="1"
          Classes="card-action channel-action encryption-select"
          Content="{Binding EncryptionButtonText}"
          Background="{Binding EncryptionSelectionBrush}"
          BorderBrush="{Binding EncryptionSelectionBorderBrush}"
          Foreground="{Binding EncryptionSelectionTextBrush}"
          Command="{Binding EncryptionCommand}"
          IsVisible="{Binding CanToggleEncryption}"
          IsEnabled="{Binding CanToggleEncryption}"
          AutomationProperties.Name="{Binding EncryptionAutomationName}"
          AutomationProperties.HelpText="{Binding EncryptionAutomationHelpText}" />
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="2">
      <Border
          Classes="ptt-input-guard"
          Background="Transparent"
          ToolTip.Tip="Push to talk; unavailable while this channel is receiving">
        <Button Classes="ptt"
                Content="{Binding PttButtonText}"
                IsEnabled="{Binding IsPttControlEnabled}"
                AutomationProperties.Name="{Binding PttAutomationName}"
                AutomationProperties.HelpText="{Binding PttAutomationHelpText}" />
      </Border>
      <Button
          Grid.Column="1"
          Classes="tx-select channel-action tx-multi"
          Classes.armed="{Binding IsTransmitSelected}"
          Content="{Binding TransmitSelectionText}"
          Background="{Binding TransmitSelectionBrush}"
          BorderBrush="{Binding TransmitSelectionBorderBrush}"
          IsEnabled="{Binding CanTransmit}"
          ToolTip.Tip="Include this channel in global multi-select PTT"
          AutomationProperties.Name="{Binding TransmitSelectionAutomationName}"
          AutomationProperties.HelpText="Include or remove this channel from global multi-select push to talk."
          Click="HandleTransmitSelectionClick" />
      <Button
          Grid.Column="2"
          Classes="tx-select channel-action page-select"
          Classes.armed="{Binding IsPageSelected}"
          Content="{Binding PageSelectionText}"
          Background="{Binding PageSelectionBrush}"
          BorderBrush="{Binding PageSelectionBorderBrush}"
          IsEnabled="{Binding CanTransmit}"
          ToolTip.Tip="Include this channel when sending QCII pages"
          AutomationProperties.Name="{Binding PageSelectionAutomationName}"
          AutomationProperties.HelpText="Include or remove this channel from Quick Call paging."
          Click="HandlePageSelectionClick" />
      <Button
          Grid.Column="3"
          Classes="tx-select channel-action alert-select"
          Classes.armed="{Binding IsAlertSelected}"
          Content="{Binding AlertSelectionText}"
          Background="{Binding AlertSelectionBrush}"
          BorderBrush="{Binding AlertSelectionBorderBrush}"
          IsEnabled="{Binding CanTransmit}"
          ToolTip.Tip="Include this channel when sending DTMF or alert tones"
          AutomationProperties.Name="{Binding AlertSelectionAutomationName}"
          AutomationProperties.HelpText="Include or remove this channel from DTMF and alert-tone targets."
          Click="HandleAlertSelectionClick" />
      <Button
          Grid.Column="4"
          Classes="tx-select channel-action tar-select"
          Classes.armed="{Binding IsRecordingEnabled}"
          Content="{Binding RecordButtonText}"
          Background="{Binding RecordingSelectionBrush}"
          BorderBrush="{Binding RecordingSelectionBorderBrush}"
          Command="{Binding RecordingCommand}"
          IsEnabled="{Binding CanRecord}"
          ToolTip.Tip="Toggle Talkgroup Audio Recording"
          AutomationProperties.Name="{Binding RecordingAutomationName}"
          AutomationProperties.HelpText="{Binding RecordingAutomationHelpText}" />
    </Grid>
  </Grid>
</UserControl>
