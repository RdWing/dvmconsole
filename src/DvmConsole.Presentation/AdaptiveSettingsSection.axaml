<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DvmConsole.Presentation.AdaptiveSettingsSection"
             x:Name="SectionRoot">
  <Border Classes="panel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="5">
      <TextBlock FontWeight="SemiBold"
                 Text="{Binding Header, ElementName=SectionRoot}" />
      <TextBlock Grid.Row="1"
                 Classes="caption"
                 Text="{Binding Description, ElementName=SectionRoot}"
                 TextWrapping="Wrap" />
      <ContentPresenter Grid.Row="2"
                        Margin="0,4,0,0"
                        HorizontalContentAlignment="Stretch"
                        Content="{Binding SectionContent, ElementName=SectionRoot}" />
    </Grid>
  </Border>
</UserControl>
