<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DvmConsole.Desktop.MainWindow"
        Title="DVM Console"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500">
  <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,*">
    <Border Grid.ColumnSpan="2" Background="#20252B" Padding="18,12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right"
                   Foreground="#AAB4BE"
                   Text="Cross-platform rebuild"
                   VerticalAlignment="Center" />
        <TextBlock Foreground="White"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="DVM Console" />
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="#F1F3F5" Padding="16">
      <ScrollViewer>
        <StackPanel Spacing="14">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Status" />
          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
          <Separator />
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Systems" />
          <ItemsControl ItemsSource="{Binding Systems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                  <StackPanel Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock FontSize="12" Text="{Binding Endpoint}" />
                    <TextBlock FontSize="12" Foreground="#986B00" Text="Offline" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Padding="16">
      <TabControl ItemsSource="{Binding Zones}">
        <TabControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <ScrollViewer Padding="4,16">
              <ItemsControl ItemsSource="{Binding Channels}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#CCD2D8"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,12,12"
                            Width="240">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                        <TextBlock Text="{Binding ModeText}" />
                        <TextBlock Foreground="#68727D" Text="{Binding DestinationText}" />
                        <Button Content="PTT" HorizontalAlignment="Left" IsEnabled="False" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Border>
  </Grid>
</Window>
