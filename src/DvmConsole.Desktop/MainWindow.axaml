<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DvmConsole.Desktop"
        x:Class="DvmConsole.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="DVM Console" Width="1260" Height="760" MinWidth="880" MinHeight="560"
        Background="#0D1116" Topmost="{Binding KeepWindowOnTop, Mode=TwoWay}">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#DCE3EB" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#91A0AF" /></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#91A0AF" /></Style>
    <Style Selector="Button"><Setter Property="Background" Value="#1A222D" /><Setter Property="Foreground" Value="#E5EBF2" /><Setter Property="BorderBrush" Value="#273443" /><Setter Property="Padding" Value="10,6" /></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#253446" /></Style>
    <Style Selector="Button.ptt"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Background" Value="#17202B" /></Style>
    <Style Selector="Button.ptt:pressed"><Setter Property="Background" Value="#0A9B48" /></Style>
    <Style Selector="Button.tx-select"><Setter Property="Padding" Value="5,2" /><Setter Property="FontSize" Value="10" /><Setter Property="Background" Value="#242038" /></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="#AEB9C5" /><Setter Property="Padding" Value="6,8" /><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="#F4F7FA" /></Style>
    <Style Selector="TabControl.zone-tabs TabItem"><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="5,6" /></Style>
    <Style Selector="ProgressBar.receive-level /template/ Border#PART_Indicator"><Setter Property="Background" Value="#00BE5A" /></Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="#1A2028" Padding="6,0">
      <DockPanel LastChildFill="False">
        <Menu Background="Transparent" Foreground="#E8EDF3">
          <MenuItem Header="File">
            <MenuItem Header="Open Codeplug…" Click="HandleOpenCodeplugClick" />
            <MenuItem Header="Import Settings…" Click="HandleImportSettingsClick" />
            <MenuItem Header="Export Settings…" Click="HandleExportSettingsClick" />
            <Separator />
            <MenuItem Header="Connect" Command="{Binding ConnectCommand}" />
            <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
            <Separator />
            <MenuItem Header="Exit" Click="HandleExitClick" />
          </MenuItem>
          <MenuItem Header="Channels">
            <MenuItem Header="Disable all receive" Click="HandleDisableAllReceiveClick" />
            <Separator />
            <MenuItem Header="Global PTT key">
              <MenuItem Header="Space" Tag="Space" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F1" Tag="F1" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F2" Tag="F2" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F3" Tag="F3" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F4" Tag="F4" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F5" Tag="F5" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F6" Tag="F6" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F7" Tag="F7" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F8" Tag="F8" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F9" Tag="F9" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F10" Tag="F10" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F11" Tag="F11" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F12" Tag="F12" Click="HandleGlobalPttKeyClick" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="Commands">
            <MenuItem Header="Page Subscriber…" Tag="CallAlert" Click="HandleSubscriberCommandClick" />
            <MenuItem Header="Radio Check Subscriber…" Tag="RadioCheck" Click="HandleSubscriberCommandClick" />
            <Separator />
            <MenuItem Header="Inhibit Subscriber…" Tag="Inhibit" Click="HandleSubscriberCommandClick" />
            <MenuItem Header="Uninhibit Subscriber…" Tag="Uninhibit" Click="HandleSubscriberCommandClick" />
            <Separator />
            <MenuItem Header="Tones">
              <MenuItem Header="QCII / alert tones" Tag="Tones" Click="HandleOpenOperatorToolsClick" />
              <MenuItem Header="DTMF" Tag="Tones" Click="HandleOpenOperatorToolsClick" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="Settings">
            <MenuItem Header="Toggle push-to-talk mode" IsChecked="{Binding TogglePttMode, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Talk permit tone" IsChecked="{Binding TalkPermitTone, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Mute RX while transmitting" IsChecked="{Binding MuteRxAudioWhileTransmitting, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Retain patch state on startup" IsChecked="{Binding RetainPatchStateOnStartup, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Restore selected channels on startup" IsChecked="{Binding RestoreSelectedChannelsOnStartup, Mode=TwoWay}" ToggleType="CheckBox" />
            <Separator />
            <MenuItem Header="Clock settings…" Tag="General" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Audio settings…" Tag="Audio" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Reset settings…" Click="HandleResetSettingsClick" />
            <MenuItem Header="All console settings…" Tag="General" Click="HandleOpenOperatorToolsClick" />
          </MenuItem>
          <MenuItem Header="Audio">
            <MenuItem Header="Audio settings…" Tag="Audio" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Test talk permit tone" Click="HandleTestTalkPermitToneClick" />
            <MenuItem Header="Web streams…" Tag="Streams" Click="HandleOpenOperatorToolsClick" />
          </MenuItem>
          <MenuItem Header="View">
            <MenuItem Header="Dark mode" IsChecked="{Binding DarkMode, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Call History…" Tag="History" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Groups…" Tag="Groups" Click="HandleOpenOperatorToolsClick" />
            <Separator />
            <MenuItem Header="Keep window on top" IsChecked="{Binding KeepWindowOnTop, Mode=TwoWay}" ToggleType="CheckBox" />
          </MenuItem>
          <MenuItem Header="Tools">
            <MenuItem Header="Talkgroup Audio Recorder">
              <MenuItem Header="Viewer…" Tag="Recorder" Click="HandleOpenOperatorToolsClick" />
              <MenuItem Header="Configuration…" Tag="Recorder" Click="HandleOpenOperatorToolsClick" />
            </MenuItem>
            <MenuItem Header="FNE Connection Manager…" Tag="Connections" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Encryption Key Status…" Tag="Connections" Click="HandleOpenOperatorToolsClick" />
          </MenuItem>
          <MenuItem Header="Help">
            <MenuItem Header="Documentation" Click="HandleDocumentationClick" />
            <MenuItem Header="About" Click="HandleAboutClick" />
          </MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Classes="muted" FontSize="11" Text="{Binding ClockText}" /><TextBlock Classes="muted" FontSize="11" Text="{Binding SystemStatusText}" /></StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,4,250">
      <Border Grid.Column="0" Background="#0D1116" Padding="10,12,8,8">
        <Grid RowDefinitions="Auto,Auto,*">
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="{Binding ConnectionButtonText}" Command="{Binding ConnectionCommand}" />
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <Ellipse Width="10" Height="10" Fill="{Binding ConnectionBrush}" />
              <StackPanel Spacing="0"><TextBlock FontWeight="SemiBold" FontSize="11" Text="{Binding ConnectionPillText}" /><TextBlock Classes="eyebrow" Text="{Binding SelectedSystemName}" /></StackPanel>
            </StackPanel>
          </DockPanel>

          <Grid Grid.Row="1" ColumnDefinitions="Auto,210,Auto,210,*" ColumnSpacing="7" Margin="0,0,0,6">
            <TextBlock Classes="eyebrow" Text="Input" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDevice, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="2" Classes="eyebrow" Text="Output" VerticalAlignment="Center" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="4" Content="Refresh devices" Command="{Binding RefreshAudioDevicesCommand}" HorizontalAlignment="Left" />
          </Grid>

          <TabControl Grid.Row="2" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem, Mode=TwoWay}">
            <TabControl.ItemTemplate><DataTemplate x:DataType="local:SystemViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate></TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate x:DataType="local:SystemViewModel">
                <TabControl Classes="zone-tabs" ItemsSource="{Binding Zones}">
                  <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ZoneViewModel">
                      <Border Background="{Binding TabBrush}" CornerRadius="4" Padding="5,2">
                        <TextBlock Foreground="{Binding TabTextBrush}" Text="{Binding Name}" />
                      </Border>
                    </DataTemplate>
                  </TabControl.ItemTemplate>
                  <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="local:ZoneViewModel">
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="4,12">
                        <ItemsControl ItemsSource="{Binding Channels}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ChannelViewModel">
                              <Border Width="{Binding CardWidth}" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,10" Focusable="True" PointerPressed="HandleChannelPointerPressed">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
                                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"><StackPanel Spacing="1"><TextBlock FontWeight="Bold" FontSize="14" Text="{Binding Name}" /><TextBlock Classes="eyebrow" Text="{Binding TalkgroupText}" /></StackPanel><TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding ModeText}" /><Button Grid.Column="2" Classes="tx-select" Content="{Binding TransmitSelectionText}" Background="{Binding TransmitSelectionBrush}" BorderBrush="{Binding TransmitSelectionBorderBrush}" IsEnabled="{Binding CanTransmit}" Click="HandleTransmitSelectionClick" /></Grid>
                                  <StackPanel Grid.Row="1" Spacing="2"><TextBlock Classes="eyebrow" Text="Last caller" /><TextBlock FontSize="11" Text="{Binding LastCallerText}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                  <ProgressBar Grid.Row="2" Classes="receive-level" Height="4" Minimum="0" Maximum="100" Value="{Binding AudioLevel}" />
                                  <Slider Grid.Row="3" Minimum="0" Maximum="2" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                                  <Button Grid.Row="4" Classes="ptt" Content="{Binding PttButtonText}" IsEnabled="{Binding CanTransmit}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DataTemplate>
                  </TabControl.ContentTemplate>
                </TabControl>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Background="#25313D" ResizeDirection="Columns" />
      <Border Grid.Column="2" Background="#151C25" Padding="8,10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="Activity" />
          <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="Call History" />
                <ItemsControl ItemsSource="{Binding CallHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CallHistoryEntry">
                      <Border Background="#1C2530" BorderBrush="#293847" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,6">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding ChannelName}" /><TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding TimestampText}" /><TextBlock Grid.Row="1" Classes="eyebrow" Text="{Binding RouteText}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Row="1" Grid.Column="1" Classes="eyebrow" Text="{Binding ProtocolText}" /><TextBlock Grid.Row="2" Classes="eyebrow" Text="{Binding EncryptionText}" /><TextBlock Grid.Row="2" Grid.Column="1" Classes="eyebrow" Text="{Binding DurationText}" /></Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="Subscriber Command Audit" />
                <ItemsControl ItemsSource="{Binding SubscriberCommandAudit}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SubscriberCommandAuditEntry">
                      <Border Background="#1C2530" BorderBrush="#293847" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,6">
                        <TextBlock Classes="eyebrow" Text="{Binding Summary}" TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#1A2028" Padding="8,5"><Grid ColumnDefinitions="*,*,*"><TextBlock Classes="eyebrow" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding AudioStatusText}" TextTrimming="CharacterEllipsis" TextAlignment="Center" /><TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding TransmitStatusText}" TextTrimming="CharacterEllipsis" TextAlignment="Right" /></Grid></Border>
  </Grid>
</Window>
