<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DvmConsole.Desktop"
        x:Class="DvmConsole.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="DVM Console" Width="1260" Height="760" MinWidth="880" MinHeight="560"
        Icon="avares://DvmConsole.Desktop/Assets/DVMConsole.png"
        Background="{DynamicResource ShellBackgroundBrush}" Topmost="{Binding KeepWindowOnTop, Mode=TwoWay}" FontSize="{Binding UiFontSize}">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiCompactFontSize}" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="Padding" Value="10,6" /></Style>
    <Style Selector="Button:not(.tx-select):pointerover"><Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Style>
    <Style Selector="Button.ptt"><Setter Property="Height" Value="21" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="3,0" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Background" Value="{DynamicResource PttBackgroundBrush}" /></Style>
    <Style Selector="Button.ptt:pressed"><Setter Property="Background" Value="#0A9B48" /></Style>
    <Style Selector="Button.card-action"><Setter Property="Padding" Value="5,2" /><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiCompactFontSize}" /></Style>
    <Style Selector="Button.tx-select"><Setter Property="Height" Value="21" /><Setter Property="Padding" Value="2,0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiCompactFontSize}" /><Setter Property="Background" Value="{DynamicResource SelectorBackgroundBrush}" /></Style>
    <Style Selector="Button.tx-multi:pointerover" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding TransmitSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding TransmitSelectionBorderBrush}" /></Style>
    <Style Selector="Button.tx-multi:pressed" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding TransmitSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding TransmitSelectionBorderBrush}" /></Style>
    <Style Selector="Button.page-select:pointerover" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding PageSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding PageSelectionBorderBrush}" /></Style>
    <Style Selector="Button.page-select:pressed" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding PageSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding PageSelectionBorderBrush}" /></Style>
    <Style Selector="Button.alert-select:pointerover" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding AlertSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding AlertSelectionBorderBrush}" /></Style>
    <Style Selector="Button.alert-select:pressed" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding AlertSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding AlertSelectionBorderBrush}" /></Style>
    <Style Selector="Button.tar-select:pointerover" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding RecordingSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding RecordingSelectionBorderBrush}" /></Style>
    <Style Selector="Button.tar-select:pressed" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding RecordingSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding RecordingSelectionBorderBrush}" /></Style>
    <Style Selector="Button.status-card"><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="6,3" /></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="{DynamicResource TabTextBrush}" /><Setter Property="Padding" Value="6,8" /><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiFontSize}" /></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource SelectedTabTextBrush}" /></Style>
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="True" /></Style>
    <Style Selector="ScrollBar"><Setter Property="AllowAutoHide" Value="True" /><Setter Property="ShowDelay" Value="0:0:0" /><Setter Property="HideDelay" Value="0:0:0.7" /></Style>
    <Style Selector="TabControl.zone-tabs TabItem"><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" /><Setter Property="Padding" Value="5,5" /></Style>
    <Style Selector="ProgressBar.receive-level /template/ Border#PART_Indicator"><Setter Property="Background" Value="#00BE5A" /></Style>
  </Window.Styles>

  <LayoutTransformControl LayoutTransform="{Binding UiScaleTransform}">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ShellHeaderBrush}" Padding="6,0">
      <DockPanel LastChildFill="False">
        <Menu Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
          <MenuItem Header="File">
            <MenuItem Header="Open Codeplug…" Click="HandleOpenCodeplugClick" />
            <MenuItem Header="Open Recent" x:Name="recentCodeplugsMenu" />
            <MenuItem Header="Import Settings…" Click="HandleImportSettingsClick" />
            <MenuItem Header="Export Settings…" Click="HandleExportSettingsClick" />
            <Separator />
            <MenuItem Header="Settings Profiles">
              <MenuItem Header="Save current profile…" Click="HandleSaveSettingsProfileClick" />
              <MenuItem Header="Load profile" x:Name="namedSettingsProfileLoadMenu" />
              <MenuItem Header="Delete profile" x:Name="namedSettingsProfileDeleteMenu" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Connect" Command="{Binding ConnectCommand}" />
            <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
            <Separator />
            <MenuItem Header="Exit" Click="HandleExitClick" />
          </MenuItem>
          <MenuItem Header="Channels">
            <MenuItem Header="Disable all receive" Click="HandleDisableAllReceiveClick" />
            <Separator />
            <MenuItem Header="Global PTT key">
              <MenuItem Header="Space" Tag="Space" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F1" Tag="F1" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F2" Tag="F2" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F3" Tag="F3" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F4" Tag="F4" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F5" Tag="F5" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F6" Tag="F6" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F7" Tag="F7" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F8" Tag="F8" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F9" Tag="F9" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F10" Tag="F10" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F11" Tag="F11" Click="HandleGlobalPttKeyClick" />
              <MenuItem Header="F12" Tag="F12" Click="HandleGlobalPttKeyClick" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="Commands">
            <MenuItem Header="Page Subscriber…" Tag="CallAlert" Click="HandleSubscriberCommandClick" />
            <MenuItem Header="Radio Check Subscriber…" Tag="RadioCheck" Click="HandleSubscriberCommandClick" />
            <Separator />
            <MenuItem Header="Inhibit Subscriber…" Tag="Inhibit" Click="HandleSubscriberCommandClick" />
            <MenuItem Header="Uninhibit Subscriber…" Tag="Uninhibit" Click="HandleSubscriberCommandClick" />
            <Separator />
            <MenuItem Header="Tones">
              <MenuItem Header="QCII / alert tones" Tag="Tones" Click="HandleOpenOperatorToolsClick" />
              <MenuItem Header="DTMF" Tag="Tones" Click="HandleOpenOperatorToolsClick" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="Settings">
            <MenuItem Header="Toggle push-to-talk mode" IsChecked="{Binding TogglePttMode, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Talk permit tone" IsChecked="{Binding TalkPermitTone, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Mute RX while transmitting" IsChecked="{Binding MuteRxAudioWhileTransmitting, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Retain patch state on startup" IsChecked="{Binding RetainPatchStateOnStartup, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Restore selected channels on startup" IsChecked="{Binding RestoreSelectedChannelsOnStartup, Mode=TwoWay}" ToggleType="CheckBox" />
            <Separator />
            <MenuItem Header="Clock settings…" Tag="General" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Audio settings…" Tag="Audio" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Reset settings…" Click="HandleResetSettingsClick" />
            <MenuItem Header="All console settings…" Tag="General" Click="HandleOpenOperatorToolsClick" />
          </MenuItem>
          <MenuItem Header="Audio">
            <MenuItem Header="Audio settings…" Tag="Audio" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Test talk permit tone" Click="HandleTestTalkPermitToneClick" />
            <MenuItem Header="Web streams…" Tag="Streams" Click="HandleOpenOperatorToolsClick" />
          </MenuItem>
          <MenuItem Header="View">
            <MenuItem Header="Dark mode" IsChecked="{Binding DarkMode, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Select user background…" Click="HandleSelectBackgroundClick" />
            <MenuItem Header="Clear user background" Click="HandleClearBackgroundClick" />
            <Separator />
            <MenuItem Header="Show system status" IsChecked="{Binding ShowSystemStatus, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Show channel widgets" IsChecked="{Binding ShowChannels, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Show alert buttons" IsChecked="{Binding ShowAlertTones, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Lock widgets" IsChecked="{Binding LockWidgets, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Reset widget layout" Click="HandleResetLayoutClick" />
            <MenuItem Header="Select/unselect all TX channels" Click="HandleToggleAllTransmitSelectionClick" />
            <Separator />
            <MenuItem Header="Event History window…" Click="HandleOpenCallHistoryClick" />
            <MenuItem Header="Dock Event History in sidebar" IsChecked="{Binding ShowCallHistoryPane, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Snap detached Event History" IsChecked="{Binding SnapCallHistoryToWindow, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Call History tools…" Tag="History" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Groups…" Tag="Groups" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Debug Logs…" Click="HandleOpenDebugLogsClick" />
            <Separator />
            <MenuItem Header="Keep window on top" IsChecked="{Binding KeepWindowOnTop, Mode=TwoWay}" ToggleType="CheckBox" />
          </MenuItem>
          <MenuItem Header="Tools">
            <MenuItem Header="Talkgroup Audio Recorder">
              <MenuItem Header="Viewer…" Tag="Recorder" Click="HandleOpenOperatorToolsClick" />
              <MenuItem Header="Configuration…" Tag="Recorder" Click="HandleOpenOperatorToolsClick" />
            </MenuItem>
            <MenuItem Header="FNE Connection Manager…" Tag="Connections" Click="HandleOpenOperatorToolsClick" />
            <MenuItem Header="Encryption Key Status…" Tag="Connections" Click="HandleOpenOperatorToolsClick" />
          </MenuItem>
          <MenuItem Header="Help">
            <MenuItem Header="Documentation" Click="HandleDocumentationClick" />
            <MenuItem Header="About" Click="HandleAboutClick" />
          </MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding ToolbarClocks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ToolbarClockViewModel"><Border IsVisible="{Binding Enabled}" Background="{Binding BackgroundBrush}" BorderBrush="{DynamicResource ClockBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2"><StackPanel><TextBlock Foreground="{DynamicResource ClockTextBrush}" FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiCompactFontSize}" Text="{Binding TimeZoneLabel}" HorizontalAlignment="Center" /><TextBlock Foreground="{DynamicResource ClockTextBrush}" FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" Text="{Binding TimeText}" HorizontalAlignment="Center" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowAlertTones}">
            <ItemsControl ItemsSource="{Binding BuiltInAlertTones}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:BuiltInAlertToneViewModel"><Button Content="{Binding Name}" Tag="{Binding}" ToolTip.Tip="Generate this legacy alert pattern on ALERT-armed channels" Padding="6,3" Click="HandleToolbarAlertToneClick" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="TONES" ToolTip.Tip="Open Console Tools directly to Tones and DTMF" Padding="6,3" Click="HandleToolbarToneToolsClick" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

      <Border Grid.Row="1" Grid.Column="0" Background="{Binding MainBackgroundBrush}" Padding="3,5,4,4">
        <Grid RowDefinitions="Auto,Auto,*">
          <DockPanel Margin="0,0,0,8" IsVisible="{Binding ShowSystemStatus}">
            <Button Classes="status-card" Command="{Binding ConnectionCommand}" ToolTip.Tip="Connect or disconnect the selected FNE">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{Binding ConnectionBrush}" />
                <StackPanel Spacing="0"><TextBlock FontWeight="SemiBold" FontSize="{Binding UiSmallFontSize}" Text="{Binding ConnectionPillText}" /><TextBlock Classes="eyebrow" Text="{Binding SelectedSystemName}" /></StackPanel>
              </StackPanel>
            </Button>
          </DockPanel>

          <Border Grid.Row="1" IsVisible="{Binding HasCodeplugDiagnostics}" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Spacing="4">
              <TextBlock FontWeight="SemiBold" Text="Codeplug diagnostics" />
              <TextBlock Classes="muted" Text="{Binding CodeplugDiagnosticsText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TabControl Grid.Row="2" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem, Mode=TwoWay}" IsVisible="{Binding ShowChannels}">
            <TabControl.ItemTemplate><DataTemplate x:DataType="local:SystemViewModel"><TextBlock Text="{Binding SystemTabText}" /></DataTemplate></TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate x:DataType="local:SystemViewModel">
                <TabControl Classes="zone-tabs" ItemsSource="{Binding Zones}">
                  <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ZoneViewModel">
                      <Border Background="{Binding TabBrush}" CornerRadius="4" Padding="5,2">
                        <TextBlock Foreground="{Binding TabTextBrush}" Text="{Binding Name}" />
                      </Border>
                    </DataTemplate>
                  </TabControl.ItemTemplate>
                  <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="local:ZoneViewModel">
                      <ScrollViewer x:Name="channelScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0">
                        <ItemsControl Classes="channel-canvas" ItemsSource="{Binding Channels}" Width="{Binding WidgetCanvasWidth}" Height="{Binding WidgetCanvasHeight}" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.Styles>
                            <Style Selector="ItemsControl.channel-canvas > ContentPresenter" x:DataType="local:ChannelViewModel">
                              <Setter Property="Canvas.Left" Value="{Binding WidgetX}" />
                              <Setter Property="Canvas.Top" Value="{Binding WidgetY}" />
                            </Style>
                          </ItemsControl.Styles>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ChannelViewModel">
                              <Border Classes="channel-card" Width="{Binding CardWidth}" Height="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ChannelCardHeight}" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5,5,5,0" Margin="0,0,5,5" Focusable="True" PointerPressed="HandleChannelPointerPressed" PointerMoved="HandleChannelPointerMoved" PointerReleased="HandleChannelPointerReleased" PointerCaptureLost="HandleChannelPointerCaptureLost" ToolTip.Tip="Drag to move this channel while widgets are unlocked">
                                  <Grid RowDefinitions="Auto,Auto,Auto,*,22" RowSpacing="3">
                                  <StackPanel Spacing="2"><TextBlock Foreground="{Binding CardTextBrush}" FontWeight="Bold" FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiFontSize}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Foreground="{Binding CardTextBrush}" FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" Text="{Binding TalkgroupText}" /></StackPanel>
                                  <TextBlock Grid.Row="1" Foreground="{Binding CardTextBrush}" FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" Text="{Binding LastCallerDisplayText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  <ProgressBar Grid.Row="2" Classes="receive-level" Height="4" Minimum="0" Maximum="100" Value="{Binding AudioLevel}" />
                                  <Grid Grid.Row="3" MinHeight="23" ClipToBounds="False" ColumnDefinitions="*,Auto" ColumnSpacing="4"><Slider Height="36" Minimum="0" Maximum="2" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"><Slider.RenderTransform><TranslateTransform Y="-4" /></Slider.RenderTransform></Slider><Button Grid.Column="1" Classes="card-action" Content="{Binding EncryptionButtonText}" Command="{Binding EncryptionCommand}" IsVisible="{Binding CanToggleEncryption}" IsEnabled="{Binding CanToggleEncryption}" /></Grid>
                                  <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="2">
                                    <Button Classes="ptt" IsEnabled="{Binding CanTransmit}"><TextBlock Text="{Binding PttButtonText}" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                                    <Button Grid.Column="1" Classes="tx-select tx-multi" Background="{Binding TransmitSelectionBrush}" BorderBrush="{Binding TransmitSelectionBorderBrush}" IsEnabled="{Binding CanTransmit}" ToolTip.Tip="Include this channel in global multi-select PTT" PointerEntered="HandleTransmitSelectionPointerEntered" Click="HandleTransmitSelectionClick"><TextBlock Text="{Binding TransmitSelectionText}" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                                    <Button Grid.Column="2" Classes="tx-select page-select" Background="{Binding PageSelectionBrush}" BorderBrush="{Binding PageSelectionBorderBrush}" IsEnabled="{Binding CanTransmit}" ToolTip.Tip="Include this channel when sending QCII pages" PointerEntered="HandlePageSelectionPointerEntered" Click="HandlePageSelectionClick"><TextBlock Text="{Binding PageSelectionText}" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                                    <Button Grid.Column="3" Classes="tx-select alert-select" Background="{Binding AlertSelectionBrush}" BorderBrush="{Binding AlertSelectionBorderBrush}" IsEnabled="{Binding CanTransmit}" ToolTip.Tip="Include this channel when sending DTMF or alert tones" PointerEntered="HandleAlertSelectionPointerEntered" Click="HandleAlertSelectionClick"><TextBlock Text="{Binding AlertSelectionText}" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                                    <Button Grid.Column="4" Classes="tx-select tar-select" Background="{Binding RecordingSelectionBrush}" BorderBrush="{Binding RecordingSelectionBorderBrush}" Command="{Binding RecordingCommand}" IsEnabled="{Binding CanRecord}" ToolTip.Tip="Toggle Talkgroup Audio Recording"><TextBlock Text="{Binding RecordButtonText}" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                                  </Grid>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DataTemplate>
                  </TabControl.ContentTemplate>
                </TabControl>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </Grid>
      </Border>
      <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="{Binding ActivitySidebarWidth}" Background="{DynamicResource SidebarBackgroundBrush}" Padding="8,10" DoubleTapped="HandleActivityDoubleTapped">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowCallHistoryPane}">
            <TextBlock FontSize="{Binding UiFontSize}" FontWeight="SemiBold" Text="Activity" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="‹" Padding="4,0" ToolTip.Tip="Collapse Activity sidebar" Click="HandleToggleActivitySidebarClick" />
          </Grid>
          <Button Content="›" Padding="0" HorizontalAlignment="Stretch" ToolTip.Tip="Expand Activity sidebar" IsVisible="{Binding IsActivitySidebarCollapsed}" Click="HandleToggleActivitySidebarClick" />
          <ScrollViewer x:Name="activityScrollViewer" Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowCallHistoryPane}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="Event History" />
                <ItemsControl ItemsSource="{Binding FilteredCallHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CallHistoryEntry">
                      <Border Background="{DynamicResource ActivityBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,6">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4"><TextBlock FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" FontWeight="SemiBold" Text="{Binding DisplayChannelText}" /><Button Grid.Column="1" Grid.RowSpan="3" Content="▶" Tag="{Binding}" IsVisible="{Binding HasRecording}" ToolTip.Tip="Play TAR recording" Padding="5,2" VerticalAlignment="Center" Click="HandlePlayCallHistoryRecordingClick" /><TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding TimestampText}" /><TextBlock Grid.Row="1" Classes="eyebrow" Text="{Binding RouteText}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Row="1" Grid.Column="2" Classes="eyebrow" Text="{Binding ProtocolText}" /><TextBlock Grid.Row="2" Classes="eyebrow" Text="{Binding EncryptionText}" /><TextBlock Grid.Row="2" Grid.Column="2" Classes="eyebrow" Text="{Binding DurationText}" /></Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="Subscriber Command Audit" />
                <ItemsControl ItemsSource="{Binding SubscriberCommandAudit}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SubscriberCommandAuditEntry">
                      <Border Background="{DynamicResource ActivityBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,6">
                        <TextBlock Classes="eyebrow" Text="{Binding Summary}" TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource StatusBarBackgroundBrush}" Padding="8,5"><Grid ColumnDefinitions="*,*,*"><TextBlock Classes="eyebrow" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding AudioStatusText}" TextTrimming="CharacterEllipsis" TextAlignment="Center" /><TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding TransmitStatusText}" TextTrimming="CharacterEllipsis" TextAlignment="Right" /></Grid></Border>
  </Grid>
  </LayoutTransformControl>
</Window>
