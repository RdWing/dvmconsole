<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DvmConsole.Desktop"
        x:Class="DvmConsole.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="DVM Console NEO" Width="1260" Height="760" MinWidth="880" MinHeight="560"
        Icon="avares://DvmConsole/Assets/DVMConsole.png"
        Background="{DynamicResource ShellBackgroundBrush}" Topmost="{Binding KeepWindowOnTop, Mode=TwoWay}" FontSize="{Binding UiFontSize}"
        SizeChanged="HandleResponsiveToolbarSizeChanged">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiCompactFontSize}" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="Padding" Value="10,6" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Button:not(.tx-select):not(.channel-action):pointerover"><Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Style>
    <Style Selector="Button.ptt"><Setter Property="Height" Value="24" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="3,0" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Background" Value="{DynamicResource PttBackgroundBrush}" /></Style>
    <Style Selector="Button.ptt:pointerover"><Setter Property="Background" Value="{DynamicResource PttBackgroundBrush}" /></Style>
    <Style Selector="Button.ptt:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PttBackgroundBrush}" /></Style>
    <Style Selector="Button.ptt:pressed"><Setter Property="Background" Value="#0A9B48" /></Style>
    <Style Selector="Button.ptt:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#0A9B48" /></Style>
    <Style Selector="Button.card-action"><Setter Property="Padding" Value="5,2" /><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiCompactFontSize}" /></Style>
    <Style Selector="Button.tx-select"><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="2,0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiCompactFontSize}" /><Setter Property="Background" Value="{DynamicResource SelectorBackgroundBrush}" /></Style>
    <Style Selector="Button.channel-action">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.channel-action:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
    <Style Selector="Button.status-card"><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" /><Setter Property="BorderThickness" Value="2" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="8,4" /></Style>
    <Style Selector="Button.status-card:pointerover" x:DataType="local:SystemViewModel"><Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" /><Setter Property="BorderBrush" Value="{Binding ConnectionBrush}" /></Style>
    <Style Selector="Button.status-card:pointerover /template/ ContentPresenter#PART_ContentPresenter" x:DataType="local:SystemViewModel"><Setter Property="BorderBrush" Value="{Binding ConnectionBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
    <Style Selector="Button.status-card:pressed" x:DataType="local:SystemViewModel"><Setter Property="BorderBrush" Value="{Binding ConnectionBrush}" /></Style>
    <Style Selector="Button.status-card:pressed /template/ ContentPresenter#PART_ContentPresenter" x:DataType="local:SystemViewModel"><Setter Property="BorderBrush" Value="{Binding ConnectionBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
    <Style Selector="ToggleButton.toolbar-audio"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="2,0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ToggleButton.mic-warm:checked"><Setter Property="Background" Value="{DynamicResource OperationalAttentionSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OperationalAttentionBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource OperationalStateTextBrush}" /></Style>
    <Style Selector="ToggleButton.mic-warm:checked:pointerover"><Setter Property="Background" Value="{DynamicResource OperationalAttentionSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OperationalAttentionBorderBrush}" /></Style>
    <Style Selector="ToggleButton.output-mute:checked"><Setter Property="Background" Value="{DynamicResource OperationalMuteSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OperationalMuteBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource OperationalStateTextBrush}" /></Style>
    <Style Selector="ToggleButton.output-mute:checked:pointerover"><Setter Property="Background" Value="{DynamicResource OperationalMuteSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OperationalMuteBorderBrush}" /></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="{DynamicResource TabTextBrush}" /><Setter Property="Padding" Value="6,8" /><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiFontSize}" /></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource SelectedTabTextBrush}" /></Style>
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="True" /></Style>
    <Style Selector="ScrollBar"><Setter Property="AllowAutoHide" Value="True" /><Setter Property="ShowDelay" Value="0:0:0" /><Setter Property="HideDelay" Value="0:0:0.7" /></Style>
    <Style Selector="TabControl.zone-tabs TabItem"><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" /><Setter Property="Padding" Value="5,5" /></Style>
  </Window.Styles>

  <LayoutTransformControl LayoutTransform="{Binding UiScaleTransform}">
  <Grid x:Name="mainShellGrid" ColumnDefinitions="*,Auto">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="0" />
      <RowDefinition Height="0" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource ShellHeaderBrush}" Padding="6,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Menu Grid.Column="0" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
          <MenuItem Header="File">
            <MenuItem Header="New Configuration…" Click="HandleNewConfigurationClick" />
            <MenuItem Header="Configuration Studio…" Click="HandleConfigurationStudioClick" />
            <Separator />
            <MenuItem Header="Open Codeplug…" Click="HandleOpenCodeplugClick" />
            <MenuItem Header="Open Recent" x:Name="recentCodeplugsMenu" />
            <MenuItem Header="Import Settings…" Click="HandleImportSettingsClick" />
            <MenuItem Header="Export Settings…" Click="HandleExportSettingsClick" />
            <Separator />
            <MenuItem Header="Settings Profiles">
              <MenuItem Header="Save current profile…" Click="HandleSaveSettingsProfileClick" />
              <MenuItem Header="Load profile" x:Name="namedSettingsProfileLoadMenu" />
              <MenuItem Header="Delete profile" x:Name="namedSettingsProfileDeleteMenu" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Connect" Command="{Binding ConnectCommand}" />
            <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
            <Separator />
            <MenuItem Header="Exit" Click="HandleExitClick" />
          </MenuItem>
          <MenuItem Header="Channels">
            <MenuItem Header="Enable all receive" Tag="channels.receive.enable-all" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Enable all receive (zone)" Tag="channels.receive.enable-zone" IsEnabled="{Binding HasSelectedZone}" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Disable all receive (zone)" Tag="channels.receive.disable-zone" IsEnabled="{Binding HasSelectedZone}" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Disable all receive" Tag="channels.receive.disable-all" Click="HandleOperatorCommandClick" />
            <Separator />
            <MenuItem Header="Global PTT key" x:Name="globalPttKeyMenu" />
            <MenuItem Header="Active-system PTT key" x:Name="activeSystemPttKeyMenu" />
            <Separator />
            <MenuItem Header="Select/unselect all TX channels" Tag="channels.transmit.toggle-all" Click="HandleOperatorCommandClick" />
          </MenuItem>
          <MenuItem Header="Commands">
            <MenuItem Header="Page Subscriber…" Tag="subscriber.page" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Radio Check Subscriber…" Tag="subscriber.radio-check" Click="HandleOperatorCommandClick" />
            <Separator />
            <MenuItem Header="Inhibit Subscriber…" Tag="subscriber.inhibit" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Uninhibit Subscriber…" Tag="subscriber.uninhibit" Click="HandleOperatorCommandClick" />
            <Separator />
            <MenuItem Header="Tones…" Tag="settings.tones" Click="HandleOperatorCommandClick" />
          </MenuItem>
          <MenuItem Header="Settings">
            <MenuItem Header="Toggle push-to-talk mode" IsChecked="{Binding TogglePttMode, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Talk permit tone" IsChecked="{Binding TalkPermitTone, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Mute RX while transmitting" IsChecked="{Binding MuteRxAudioWhileTransmitting, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Retain patch state on startup" IsChecked="{Binding RetainPatchStateOnStartup, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Restore selected channels on startup" IsChecked="{Binding RestoreSelectedChannelsOnStartup, Mode=TwoWay}" ToggleType="CheckBox" />
            <Separator />
            <MenuItem Header="Global PTT settings…" Tag="settings.ptt" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Clock settings…" Tag="settings.clock" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Audio settings…" Tag="settings.audio" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Reset settings…" Click="HandleResetSettingsClick" />
            <MenuItem Header="All console settings…" Tag="settings.general" Click="HandleOperatorCommandClick" />
          </MenuItem>
          <MenuItem Header="Audio">
            <MenuItem Header="Audio settings…" Tag="settings.audio" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Web streams…" Tag="settings.streams" Click="HandleOperatorCommandClick" />
          </MenuItem>
          <MenuItem Header="View">
            <MenuItem Header="Dark mode" IsChecked="{Binding DarkMode, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Select user background…" Click="HandleSelectBackgroundClick" />
            <MenuItem Header="Clear user background" Click="HandleClearBackgroundClick" />
            <Separator />
            <MenuItem Header="Show system status" IsChecked="{Binding ShowSystemStatus, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Show alert buttons" IsChecked="{Binding ShowAlertTones, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Lock widgets" IsChecked="{Binding LockWidgets, Mode=TwoWay}" ToggleType="CheckBox" />
            <MenuItem Header="Reset widget layout" Click="HandleResetLayoutClick" />
            <Separator />
            <MenuItem Header="History…" Tag="settings.history" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Groups…" Click="HandleConfigurationGroupsClick" />
            <MenuItem Header="Debug Logs…" Tag="view.debug-logs" Click="HandleOperatorCommandClick" />
            <MenuItem x:Name="engineeringHealthMenuItem"
                      Header="Engineering Health"
                      ToggleType="CheckBox"
                      Tag="view.engineering-health"
                      Click="HandleOperatorCommandClick" />
            <Separator />
            <MenuItem Header="Keep window on top" IsChecked="{Binding KeepWindowOnTop, Mode=TwoWay}" ToggleType="CheckBox" />
          </MenuItem>
          <MenuItem Header="Tools">
            <MenuItem Header="Talkgroup Audio Recorder">
              <MenuItem Header="Viewer…" Tag="settings.history" Click="HandleOperatorCommandClick" />
              <MenuItem Header="Configuration…" Tag="settings.recorder" Click="HandleOperatorCommandClick" />
            </MenuItem>
            <Separator />
            <MenuItem Header="FNE Connection Manager…" Tag="settings.connections" Click="HandleOperatorCommandClick" />
            <MenuItem Header="Encryption Key Status…" Tag="settings.encryption-keys" Click="HandleOperatorCommandClick" />
          </MenuItem>
          <MenuItem Header="Help">
            <MenuItem Header="Documentation" Tag="help.documentation" Click="HandleOperatorCommandClick" />
            <MenuItem Header="About" Tag="help.about" Click="HandleOperatorCommandClick" />
          </MenuItem>
        </Menu>
        <ItemsControl Grid.Column="2"
                      x:Name="toolbarClocks"
                      ItemsSource="{Binding ToolbarClocks}"
                      Margin="8,0,10,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Configured toolbar clocks">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ToolbarClockViewModel"><Border IsVisible="{Binding Enabled}" Background="{Binding BackgroundBrush}" BorderBrush="{DynamicResource ClockBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2"><StackPanel><TextBlock Foreground="{DynamicResource ClockTextBrush}" FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiCompactFontSize}" Text="{Binding TimeZoneLabel}" HorizontalAlignment="Center" /><TextBlock Foreground="{DynamicResource ClockTextBrush}" FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" Text="{Binding TimeText}" HorizontalAlignment="Center" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <ToggleButton Classes="toolbar-audio mic-warm" Content="🎙️"
                        IsChecked="{Binding KeepTransmitMicrophoneWarm, Mode=TwoWay}"
                        ToolTip.Tip="{Binding KeepTransmitMicrophoneWarmToolTip}"
                        AutomationProperties.Name="{Binding KeepTransmitMicrophoneWarmToolTip}" />
          <ToggleButton Classes="toolbar-audio output-mute"
                        Width="42"
                        Content="{Binding SelectedSystemOutputMuteGlyph}"
                        IsChecked="{Binding SelectedSystemOutputMuted, Mode=OneWay}"
                        Command="{Binding ToggleSelectedSystemOutputMuteCommand}"
                        ToolTip.Tip="{Binding SelectedSystemOutputMuteToolTip}"
                        AutomationProperties.Name="{Binding SelectedSystemOutputMuteToolTip}" />
          <ToggleButton Classes="toolbar-audio output-mute"
                        Width="42"
                        Content="{Binding SelectedZoneOutputMuteGlyph}"
                        IsChecked="{Binding SelectedZoneOutputMuted, Mode=OneWay}"
                        Command="{Binding ToggleSelectedZoneOutputMuteCommand}"
                        ToolTip.Tip="{Binding SelectedZoneOutputMuteToolTip}"
                        AutomationProperties.Name="{Binding SelectedZoneOutputMuteToolTip}" />
          <ToggleButton Classes="toolbar-audio output-mute"
                        Content="{Binding OutputMuteGlyph}"
                        IsChecked="{Binding OutputMuted, Mode=TwoWay}"
                        ToolTip.Tip="{Binding OutputMuteToolTip}"
                        AutomationProperties.Name="{Binding OutputMuteToolTip}" />
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowAlertTones}">
            <ItemsControl x:Name="toolbarAlertToneShortcuts"
                          ItemsSource="{Binding BuiltInAlertTones}"
                          AutomationProperties.Name="Alert tone shortcuts">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:BuiltInAlertToneViewModel"><Button Content="{Binding Name}" Tag="{Binding}" ToolTip.Tip="{Binding Description}" Padding="6,3" AutomationProperties.Name="{Binding Description}" Click="HandleToolbarAlertToneClick" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="toolbarTonesLauncher" Content="TONES" Tag="settings.tones" ToolTip.Tip="Open Console Settings directly to Tones and DTMF" Padding="6,3" AutomationProperties.Name="Open Tones and DTMF" Click="HandleOperatorCommandClick" />
          </StackPanel>
          <Menu x:Name="toolbarOverflowMenu"
                Background="Transparent"
                AutomationProperties.Name="Responsive toolbar overflow">
            <MenuItem Header="MORE" AutomationProperties.Name="More toolbar items">
              <MenuItem Header="Configured clocks" Tag="settings.clock" Click="HandleOperatorCommandClick" />
              <Separator />
              <MenuItem Header="Send ALERT 1" Tag="{Binding BuiltInAlertTones[0]}" AutomationProperties.Name="Send alert tone 1" Click="HandleResponsiveAlertToneClick" />
              <MenuItem Header="Send ALERT 2" Tag="{Binding BuiltInAlertTones[1]}" AutomationProperties.Name="Send alert tone 2" Click="HandleResponsiveAlertToneClick" />
              <MenuItem Header="Send ALERT 3" Tag="{Binding BuiltInAlertTones[2]}" AutomationProperties.Name="Send alert tone 3" Click="HandleResponsiveAlertToneClick" />
              <MenuItem Header="Tones and DTMF…" Tag="settings.tones" Click="HandleOperatorCommandClick" />
            </MenuItem>
          </Menu>
        </StackPanel>
      </Grid>
    </Border>

      <Border Grid.Row="1" Grid.Column="0" Background="{Binding MainBackgroundBrush}" Padding="3,5,4,4">
        <Grid RowDefinitions="Auto,Auto,*">
          <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Systems}" IsVisible="{Binding ShowSystemStatus}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SystemViewModel">
                <Button Classes="status-card" BorderBrush="{Binding ConnectionBrush}" Tag="{Binding}" ToolTip.Tip="{Binding ConnectionActionText}" Click="HandleSystemStatusClick">
                  <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <StackPanel Spacing="0"><TextBlock FontWeight="SemiBold" FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" Text="{Binding ConnectionPillText}" /><TextBlock Classes="eyebrow" Text="{Binding Name}" /></StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="1" IsVisible="{Binding HasCodeplugDiagnostics}" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
              <TextBlock FontWeight="SemiBold" Text="Codeplug diagnostics" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Dismiss" Padding="8,3" Click="HandleDismissCodeplugDiagnosticsClick" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" Text="{Binding CodeplugDiagnosticsText}" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <TabControl Grid.Row="2" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem, Mode=TwoWay}" IsVisible="{Binding ShowChannels}">
            <TabControl.ItemTemplate>
              <DataTemplate x:DataType="local:SystemViewModel">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding Name}" /><TextBlock Foreground="{Binding StatusAccentBrush}" Text="{Binding StatusGlyph}" /></StackPanel>
                  <Border Height="3" CornerRadius="2" Background="{Binding StatusAccentBrush}" Opacity="{Binding ActivityBarOpacity}" />
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate x:DataType="local:SystemViewModel">
                <TabControl Classes="zone-tabs" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone, Mode=TwoWay}">
                  <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ZoneViewModel">
                      <Border Background="{Binding TabBrush}" CornerRadius="4" Padding="5,2">
                        <StackPanel Spacing="3"><TextBlock Foreground="{Binding TabTextBrush}" Text="{Binding Name}" /><Border Height="3" CornerRadius="2" Background="{Binding ActivityBrush}" Opacity="{Binding ActivityBarOpacity}" /></StackPanel>
                      </Border>
                    </DataTemplate>
                  </TabControl.ItemTemplate>
                  <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="local:ZoneViewModel">
                      <ScrollViewer x:Name="channelScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0">
                        <ItemsControl Classes="channel-canvas" ItemsSource="{Binding Channels}" Width="{Binding WidgetCanvasWidth}" Height="{Binding WidgetCanvasHeight}" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.Styles>
                            <Style Selector="ItemsControl.channel-canvas > ContentPresenter" x:DataType="local:ChannelViewModel">
                              <Setter Property="Canvas.Left" Value="{Binding WidgetX}" />
                              <Setter Property="Canvas.Top" Value="{Binding WidgetY}" />
                            </Style>
                          </ItemsControl.Styles>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ChannelViewModel">
                              <Border Classes="channel-card" Width="{Binding CardWidth}" Height="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ChannelCardHeight}" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5,5,5,4" ClipToBounds="True" Focusable="True" PointerPressed="HandleChannelPointerPressed" PointerMoved="HandleChannelPointerMoved" PointerReleased="HandleChannelPointerReleased" PointerCaptureLost="HandleChannelPointerCaptureLost" ToolTip.Tip="Drag to move this channel while widgets are unlocked">
                                <local:ChannelCardContent
                                    UiFontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiFontSize}"
                                    UiSmallFontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}"
                                    TransmitSelectionClick="HandleTransmitSelectionClick"
                                    PageSelectionClick="HandlePageSelectionClick"
                                    AlertSelectionClick="HandleAlertSelectionClick" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DataTemplate>
                  </TabControl.ContentTemplate>
                </TabControl>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </Grid>
      </Border>
      <Border Grid.Row="1" Grid.Column="1" Width="{Binding ActivitySidebarWidth}" Background="{DynamicResource SidebarBackgroundBrush}" Padding="8,10">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4" IsVisible="{Binding ShowCallHistoryPane}" DoubleTapped="HandleActivityDoubleTapped">
            <TextBlock FontSize="{Binding UiFontSize}" FontWeight="SemiBold" Text="Activity" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding ActivityZoneFilterButtonText}" Padding="6,2" ToolTip.Tip="Switch Event History between the complete system and the current zone" Click="HandleToggleActivityZoneFilterClick" />
            <Button Grid.Column="2" Content="{Binding ActivityReceiveFilterButtonText}" Padding="6,2" ToolTip.Tip="Switch Event History between RX-enabled channels and all channel activity" Click="HandleToggleActivityReceiveFilterClick" />
            <Button Grid.Column="3" Content="‹" Padding="4,0" ToolTip.Tip="Collapse Activity sidebar" Click="HandleToggleActivitySidebarClick" />
          </Grid>
          <Button Content="›" Padding="0" HorizontalAlignment="Stretch" ToolTip.Tip="Expand Activity sidebar" IsVisible="{Binding IsActivitySidebarCollapsed}" Click="HandleToggleActivitySidebarClick" />
          <ScrollViewer x:Name="activityScrollViewer" Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowCallHistoryPane}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="Event History" />
                <ItemsControl x:Name="activityCallHistoryList" ItemsSource="{Binding ActivityCallHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CallHistoryEntry">
                      <Border Classes="activity-call-card" Background="{DynamicResource ActivityBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,6" DoubleTapped="HandleCallHistoryDoubleTapped" ToolTip.Tip="Double-click to show the TAR recording in Finder or Explorer">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4"><TextBlock FontSize="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" FontWeight="SemiBold" Text="{Binding DisplayChannelText}" /><Button Grid.Column="1" Grid.RowSpan="3" Tag="{Binding}" IsVisible="{Binding HasPlayableRecording}" ToolTip.Tip="{Binding RecordingPlaybackToolTip}" Padding="5,2" VerticalAlignment="Center" Click="HandlePlayCallHistoryRecordingClick"><Grid><PathIcon Width="11" Height="11" IsVisible="{Binding !IsRecordingPlaying}" Data="M 2,1 L 11,6 L 2,11 Z" /><PathIcon Width="11" Height="11" IsVisible="{Binding IsRecordingPlaying}" Data="M 2,2 H 10 V 10 H 2 Z" /></Grid></Button><TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding TimestampText}" /><TextBlock Grid.Row="1" Classes="eyebrow" Text="{Binding RouteText}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Row="1" Grid.Column="2" Classes="eyebrow" Text="{Binding ProtocolText}" /><TextBlock Grid.Row="2" Classes="eyebrow" Text="{Binding EncryptionText}" /><TextBlock Grid.Row="2" Grid.Column="2" Classes="eyebrow" Text="{Binding DurationText}" /></Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="Subscriber Command Audit" />
                <ItemsControl ItemsSource="{Binding ActivitySubscriberCommandAudit}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SubscriberCommandAuditEntry">
                      <Border Background="{DynamicResource ActivityBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,6">
                        <TextBlock Classes="eyebrow" Text="{Binding Summary}" TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    <GridSplitter x:Name="engineeringHealthSplitter"
                  Grid.Row="2"
                  Grid.ColumnSpan="2"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  Background="{DynamicResource ControlBorderBrush}"
                  IsVisible="False"
                  PointerReleased="HandleEngineeringHealthSplitterPointerReleased" />
    <local:EngineeringHealthPane x:Name="engineeringHealthPane"
                                 Grid.Row="3"
                                 Grid.ColumnSpan="2"
                                 IsVisible="False" />
    <Border Grid.Row="4" Grid.ColumnSpan="2" Background="{DynamicResource StatusBarBackgroundBrush}" Padding="8,5"><Grid ColumnDefinitions="*,*,*"><TextBlock Classes="eyebrow" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding AudioStatusText}" TextTrimming="CharacterEllipsis" TextAlignment="Center" /><TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding TransmitStatusText}" TextTrimming="CharacterEllipsis" TextAlignment="Right" /></Grid></Border>
  </Grid>
  </LayoutTransformControl>
</Window>
