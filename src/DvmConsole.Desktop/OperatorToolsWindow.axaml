<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DvmConsole.Desktop"
        x:Class="DvmConsole.Desktop.OperatorToolsWindow"
        x:DataType="local:MainWindowViewModel"
        Title="Console Tools" Width="920" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Opacity" Value="0.72" /><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Border.panel"><Setter Property="BorderBrush" Value="#3A4654" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="10,6" /></Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <TabControl x:Name="ToolTabs" Margin="10">
      <TabItem Header="Audio">
        <ScrollViewer Padding="10">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Audio Settings" />
            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
              <TextBlock Text="Input device" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDevice, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="2" Text="Output device" VerticalAlignment="Center" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Refresh devices" Command="{Binding RefreshAudioDevicesCommand}" />
                <Button Content="Test talk permit tone" Click="HandleTestPermitToneClick" />
              </StackPanel>
            </Grid>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Microphone processing" />
                <Grid ColumnDefinitions="Auto,100,Auto,100,Auto,100,Auto,100" ColumnSpacing="8">
                  <TextBlock Text="Gain" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding AudioInputGainText, Mode=TwoWay}" />
                  <TextBlock Grid.Column="2" Text="Low dB" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding AudioInputLowGainText, Mode=TwoWay}" />
                  <TextBlock Grid.Column="4" Text="Mid dB" VerticalAlignment="Center" /><TextBox Grid.Column="5" Text="{Binding AudioInputMidGainText, Mode=TwoWay}" />
                  <TextBlock Grid.Column="6" Text="High dB" VerticalAlignment="Center" /><TextBox Grid.Column="7" Text="{Binding AudioInputHighGainText, Mode=TwoWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox Content="Automatic gain control" IsChecked="{Binding AudioInputAgcEnabled, Mode=TwoWay}" />
                  <Button Content="Apply" Command="{Binding ApplyAudioInputSettingsCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Microphone presets" />
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="240" Watermark="Preset name" Text="{Binding AudioInputPresetNameText, Mode=TwoWay}" /><Button Content="Save current" Click="HandleSaveAudioInputPresetClick" /></StackPanel>
                <ItemsControl ItemsSource="{Binding AudioInputPresets}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:AudioInputPresetViewModel"><Border Classes="panel"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Use" Tag="{Binding}" Click="HandleUseAudioInputPresetClick" /><Button Grid.Column="2" Content="Delete" Tag="{Binding}" Click="HandleDeleteAudioInputPresetClick" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Tones">
        <ScrollViewer Padding="10">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Tones and DTMF" />
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="DTMF" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="180" Watermark="Digits" Text="{Binding DtmfDigits, Mode=TwoWay}" /><Button Content="Send" Command="{Binding SendDtmfCommand}" /><TextBox Width="200" Watermark="Preset name" Text="{Binding DtmfPresetName, Mode=TwoWay}" /><Button Content="Save preset" Command="{Binding SaveDtmfPresetCommand}" /></StackPanel><ItemsControl ItemsSource="{Binding DtmfPresets}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:DtmfPresetViewModel"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4"><TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Use" Tag="{Binding}" Click="HandleUseDtmfPresetClick" /><Button Grid.Column="2" Content="Send" Tag="{Binding}" Click="HandleSendDtmfPresetClick" /><Button Grid.Column="3" Content="Delete" Tag="{Binding}" Click="HandleDeleteDtmfPresetClick" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="Alert / QCII tone" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="110" Watermark="Hz" Text="{Binding ToneFrequencyText, Mode=TwoWay}" /><TextBox Width="110" Watermark="Seconds" Text="{Binding ToneDurationText, Mode=TwoWay}" /><Button Content="Send" Command="{Binding SendToneCommand}" /><TextBox Width="200" Watermark="Preset name" Text="{Binding TonePresetName, Mode=TwoWay}" /><Button Content="Save preset" Command="{Binding SaveTonePresetCommand}" /></StackPanel><ItemsControl ItemsSource="{Binding TonePresets}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:TonePresetViewModel"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4"><TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Use" Tag="{Binding}" Click="HandleUseTonePresetClick" /><Button Grid.Column="2" Content="Send" Tag="{Binding}" Click="HandleSendTonePresetClick" /><Button Grid.Column="3" Content="Delete" Tag="{Binding}" Click="HandleDeleteTonePresetClick" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <TextBlock Classes="caption" Text="Generated tones transmit on the channel or channels selected with the TX indicator." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Streams">
        <ScrollViewer Padding="10"><StackPanel Spacing="10"><TextBlock Classes="heading" Text="Web Streams" /><ItemsControl ItemsSource="{Binding WebStreams}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:WebStreamViewModel"><Border Classes="panel"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="caption" Text="{Binding StatusText}" /></StackPanel><Button Grid.Column="1" Content="{Binding ToggleButtonText}" Command="{Binding ToggleCommand}" /><Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,180,Auto,*,Auto" ColumnSpacing="8"><TextBlock Text="Volume" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Volume, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="Output ID" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding OutputDeviceIdText, Mode=TwoWay}" /><Button Grid.Column="4" Content="Save route" Tag="{Binding}" Click="HandleSaveWebStreamOutputDeviceClick" /></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Classes="caption" Text="Streams are loaded from the active codeplug." /></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Recorder">
        <ScrollViewer Padding="10"><StackPanel Spacing="12"><TextBlock Classes="heading" Text="Talkgroup Audio Recorder" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Retention days" VerticalAlignment="Center" /><TextBox Width="90" Text="{Binding RecordingRetentionDaysText, Mode=TwoWay}" /><Button Content="Apply and prune" Command="{Binding ApplyRecordingRetentionCommand}" /></StackPanel><TextBlock FontWeight="SemiBold" Text="Channel recording configuration" /><ItemsControl ItemsSource="{Binding Systems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:SystemViewModel"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" Margin="0,6" /><ItemsControl ItemsSource="{Binding Channels}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ChannelViewModel"><Border Classes="panel"><Grid ColumnDefinitions="*,Auto,220,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Classes="caption" Text="{Binding DestinationText}" /></StackPanel><Button Grid.Column="1" Content="{Binding RecordButtonText}" Command="{Binding RecordingCommand}" /><TextBox Grid.Column="2" Watermark="Ignored RIDs, comma separated" Text="{Binding IgnoredSubscriberIdsText, Mode=TwoWay}" /><Button Grid.Column="3" Content="Save ignored RIDs" Tag="{Binding}" Click="HandleSaveIgnoredSubscribersClick" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock FontWeight="SemiBold" Text="Completed recordings" /><ItemsControl ItemsSource="{Binding Recordings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:CallRecordingMetadata"><Border Classes="panel"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="{Binding FileName}" /></StackPanel><Button Grid.Column="1" Content="Open" Tag="{Binding}" Click="HandleOpenRecordingClick" /><Button Grid.Column="2" Content="Delete" Tag="{Binding}" Click="HandleDeleteRecordingClick" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="History">
        <ScrollViewer Padding="10"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Classes="heading" Text="Call History" /><Button Grid.Column="1" Content="Export CSV…" Click="HandleExportCallHistoryClick" /><Button Grid.Column="2" Content="Clear" Click="HandleClearCallHistoryClick" /></Grid><ItemsControl ItemsSource="{Binding CallHistory}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:CallHistoryEntry"><Border Classes="panel"><Grid ColumnDefinitions="110,*,120,100,100" ColumnSpacing="8"><TextBlock Text="{Binding TimestampText}" /><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding ChannelName}" /><TextBlock Classes="caption" Text="{Binding RouteText}" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding SystemName}" /><TextBlock Grid.Column="3" Text="{Binding EncryptionText}" /><TextBlock Grid.Column="4" Text="{Binding DurationText}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Groups">
        <ScrollViewer Padding="10"><StackPanel Spacing="10"><TextBlock Classes="heading" Text="Patch Groups" /><ItemsControl ItemsSource="{Binding PatchGroups}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:PatchGroupEditorViewModel"><Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><StackPanel Orientation="Horizontal" Spacing="12"><CheckBox Content="Enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" /><CheckBox Content="One-way" IsChecked="{Binding IsOneWay, Mode=TwoWay}" /></StackPanel><ItemsControl ItemsSource="{Binding Members}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:PatchMemberEditorViewModel"><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsMember, Mode=TwoWay}" IsEnabled="{Binding CanTransmit}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button HorizontalAlignment="Left" Content="Apply group" Tag="{Binding}" Click="HandleApplyPatchGroupClick" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Connections">
        <ScrollViewer Padding="10"><StackPanel Spacing="12"><TextBlock Classes="heading" Text="FNE Connections and Key Status" /><ItemsControl ItemsSource="{Binding Systems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:SystemViewModel"><Border Classes="panel"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="caption" Text="{Binding Endpoint}" /><TextBlock Text="{Binding ConnectionStatus}" /></StackPanel><Button Grid.Column="1" Content="Connect" Tag="{Binding}" Click="HandleConnectSystemClick" /><Button Grid.Column="2" Content="Disconnect" Tag="{Binding}" Click="HandleDisconnectSystemClick" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock FontWeight="SemiBold" Text="Channel key status" /><ItemsControl ItemsSource="{Binding Systems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:SystemViewModel"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" Margin="0,6" /><ItemsControl ItemsSource="{Binding Channels}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ChannelViewModel"><Grid ColumnDefinitions="*,100,140" Margin="0,3"><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding ModeText}" /><TextBlock Grid.Column="2" Text="{Binding EncryptionStatusText}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="General">
        <ScrollViewer Padding="10"><StackPanel Spacing="10"><TextBlock Classes="heading" Text="Console Settings" /><CheckBox Content="Toggle global PTT instead of hold-to-talk" IsChecked="{Binding TogglePttMode, Mode=TwoWay}" /><CheckBox Content="Talk permit tone" IsChecked="{Binding TalkPermitTone, Mode=TwoWay}" /><CheckBox Content="Mute RX while transmitting" IsChecked="{Binding MuteRxAudioWhileTransmitting, Mode=TwoWay}" /><CheckBox Content="Restore selected channels on startup" IsChecked="{Binding RestoreSelectedChannelsOnStartup, Mode=TwoWay}" /><CheckBox Content="Retain patch state on startup" IsChecked="{Binding RetainPatchStateOnStartup, Mode=TwoWay}" /><CheckBox Content="Dark mode" IsChecked="{Binding DarkMode, Mode=TwoWay}" /><CheckBox Content="Keep window on top" IsChecked="{Binding KeepWindowOnTop, Mode=TwoWay}" /><Separator /><TextBlock FontWeight="SemiBold" Text="Clock" /><CheckBox Content="Use 24-hour time" IsChecked="{Binding ClockUse24HourTime, Mode=TwoWay}" /><CheckBox Content="Show seconds" IsChecked="{Binding ClockShowSeconds, Mode=TwoWay}" /><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="caption" Text="Global PTT key:" /><TextBlock Classes="caption" Text="{Binding GlobalPttKeyText}" /></StackPanel></StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" BorderBrush="#3A4654" BorderThickness="0,1,0,0" Padding="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="caption" Text="{Binding AudioStatusText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Close" Click="HandleCloseClick" /></Grid></Border>
  </Grid>
</Window>
