<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DvmConsole.Desktop"
        x:Class="DvmConsole.Desktop.OperatorToolsWindow"
        x:DataType="local:MainWindowViewModel"
        Title="Console Tools" Width="920" Height="680" MinWidth="720" MinHeight="520" Background="{DynamicResource ShellBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Opacity" Value="0.72" /><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="10,6" /></Style>
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="True" /></Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <TabControl x:Name="ToolTabs" Margin="10">
      <TabItem Header="Audio">
        <ScrollViewer Padding="10">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Audio Settings" />
            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
              <TextBlock Text="Input device" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDevice, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="2" Text="Output device" VerticalAlignment="Center" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Refresh devices" Command="{Binding RefreshAudioDevicesCommand}" />
                <Button Content="Test talk permit tone" Click="HandleTestPermitToneClick" />
              </StackPanel>
            </Grid>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Microphone processing" />
                <Grid ColumnDefinitions="Auto,100,Auto,100,Auto,100,Auto,100" ColumnSpacing="8">
                  <TextBlock Text="Gain" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding AudioInputGainText, Mode=TwoWay}" />
                  <TextBlock Grid.Column="2" Text="Low dB" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding AudioInputLowGainText, Mode=TwoWay}" />
                  <TextBlock Grid.Column="4" Text="Mid dB" VerticalAlignment="Center" /><TextBox Grid.Column="5" Text="{Binding AudioInputMidGainText, Mode=TwoWay}" />
                  <TextBlock Grid.Column="6" Text="High dB" VerticalAlignment="Center" /><TextBox Grid.Column="7" Text="{Binding AudioInputHighGainText, Mode=TwoWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox Content="Automatic gain control" IsChecked="{Binding AudioInputAgcEnabled, Mode=TwoWay}" />
                  <Button Content="Apply" Command="{Binding ApplyAudioInputSettingsCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Microphone presets" />
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="240" Watermark="Preset name" Text="{Binding AudioInputPresetNameText, Mode=TwoWay}" /><Button Content="Save current" Click="HandleSaveAudioInputPresetClick" /></StackPanel>
                <ItemsControl ItemsSource="{Binding AudioInputPresets}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:AudioInputPresetViewModel"><Border Classes="panel"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Use" Tag="{Binding}" Click="HandleUseAudioInputPresetClick" /><Button Grid.Column="2" Content="Delete" Tag="{Binding}" Click="HandleDeleteAudioInputPresetClick" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Per-channel output routes" />
                <TextBlock Classes="caption" Text="Choose a discovered output device for each receive channel. System default removes a channel-specific override." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Systems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SystemViewModel">
                      <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Channels}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ChannelViewModel">
                              <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="8" Margin="0,2">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDeviceOptions}" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="Save route" Tag="{Binding}" Click="HandleSaveOutputDeviceClick" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Tones">
        <ScrollViewer Padding="10">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Tones and DTMF" />
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="DTMF" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="180" Watermark="Digits" Text="{Binding DtmfDigits, Mode=TwoWay}" /><Button Content="Send" Command="{Binding SendDtmfCommand}" /><TextBox Width="200" Watermark="Preset name" Text="{Binding DtmfPresetName, Mode=TwoWay}" /><Button Content="Save preset" Command="{Binding SaveDtmfPresetCommand}" /></StackPanel><ItemsControl ItemsSource="{Binding DtmfPresets}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:DtmfPresetViewModel"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4"><TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Use" Tag="{Binding}" Click="HandleUseDtmfPresetClick" /><Button Grid.Column="2" Content="Send" Tag="{Binding}" Click="HandleSendDtmfPresetClick" /><Button Grid.Column="3" Content="Delete" Tag="{Binding}" Click="HandleDeleteDtmfPresetClick" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="Alert / QCII tone" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="110" Watermark="Hz" Text="{Binding ToneFrequencyText, Mode=TwoWay}" /><TextBox Width="110" Watermark="Seconds" Text="{Binding ToneDurationText, Mode=TwoWay}" /><Button Content="Send" Command="{Binding SendToneCommand}" /><TextBox Width="200" Watermark="Preset name" Text="{Binding TonePresetName, Mode=TwoWay}" /><Button Content="Save preset" Command="{Binding SaveTonePresetCommand}" /></StackPanel><ItemsControl ItemsSource="{Binding TonePresets}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:TonePresetViewModel"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4"><TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Use" Tag="{Binding}" Click="HandleUseTonePresetClick" /><Button Grid.Column="2" Content="Send" Tag="{Binding}" Click="HandleSendTonePresetClick" /><Button Grid.Column="3" Content="Delete" Tag="{Binding}" Click="HandleDeleteTonePresetClick" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="Quick Call II / page" /><TextBlock Classes="caption" Text="Tone A is sent for 1 second, then tone B for 3 seconds. Arm PAGE on the channel cards to choose targets; PAGE clears after a successful send." TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="110" Watermark="Tone A Hz" Text="{Binding QuickCallToneAText, Mode=TwoWay}" /><TextBox Width="110" Watermark="Tone B Hz" Text="{Binding QuickCallToneBText, Mode=TwoWay}" /><Button Content="Send QCII page" Click="HandleSendQuickCallClick" /></StackPanel></StackPanel></Border>
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="Custom alert assets" /><TextBlock Classes="caption" Text="Import PCM WAV or MPEG audio up to 30 seconds. The asset is converted to 8 kHz mono before radio transmission." TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="240" Watermark="Display name (optional)" Text="{Binding AlertToneNameText, Mode=TwoWay}" /><Button Content="Import audio…" Click="HandleImportAlertToneClick" /></StackPanel><ItemsControl ItemsSource="{Binding AlertTones}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:AlertToneViewModel"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4"><StackPanel><TextBlock Text="{Binding DisplayText}" /><TextBlock Classes="caption" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" Content="Send" Tag="{Binding}" Click="HandleSendAlertToneClick" /><Button Grid.Column="2" Content="Delete" Tag="{Binding}" Click="HandleDeleteAlertToneClick" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <TextBlock Classes="caption" Text="Generated tones transmit on the channel or channels selected with the TX indicator." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Streams">
        <ScrollViewer Padding="10"><StackPanel Spacing="10"><TextBlock Classes="heading" Text="Web Streams" /><ItemsControl ItemsSource="{Binding WebStreams}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:WebStreamViewModel"><Border Classes="panel"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="caption" Text="{Binding StatusText}" /></StackPanel><Button Grid.Column="1" Content="{Binding ToggleButtonText}" Command="{Binding ToggleCommand}" /><Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,180,Auto,220,Auto" ColumnSpacing="8"><TextBlock Text="Volume" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Volume, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="Output" VerticalAlignment="Center" /><ComboBox Grid.Column="3" ItemsSource="{Binding OutputDeviceOptions}" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="4" Content="Save route" Tag="{Binding}" Click="HandleSaveWebStreamOutputDeviceClick" /></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Classes="caption" Text="Streams are loaded from the active codeplug." /></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Recorder">
        <ScrollViewer Padding="10">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Talkgroup Audio Recorder" />
            <Border Classes="panel">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Storage" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding RecordingRootPathText, Mode=TwoWay}" />
                <Button Grid.Column="2" Content="Browse…" Click="HandleChooseRecordingRootClick" />
                <Button Grid.Column="3" Content="Apply folder" Click="HandleApplyRecordingRootClick" />
              </Grid>
            </Border>
            <Grid ColumnDefinitions="Auto,90,Auto,220" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <TextBlock Text="Retention days" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding RecordingRetentionDaysText, Mode=TwoWay}" />
              <Button Grid.Column="2" Content="Apply and prune" Command="{Binding ApplyRecordingRetentionCommand}" />
              <TextBox Grid.Column="3" Watermark="Search recordings" Text="{Binding RecordingFilterText, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Text="Direction" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RecordingDirectionFilters}" SelectedItem="{Binding RecordingDirectionFilter, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="Protocol" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding RecordingProtocolFilters}" SelectedItem="{Binding RecordingProtocolFilter, Mode=TwoWay}" />
              <TextBlock Grid.Row="2" Text="Encryption" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RecordingEncryptionFilters}" SelectedItem="{Binding RecordingEncryptionFilter, Mode=TwoWay}" />
              <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="Clear catalog filters" HorizontalAlignment="Left" Click="HandleClearRecordingFiltersClick" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
              <TextBox Watermark="System" Text="{Binding RecordingSystemFilterText, Mode=TwoWay}" />
              <TextBox Grid.Column="1" Watermark="Channel" Text="{Binding RecordingChannelFilterText, Mode=TwoWay}" />
              <TextBox Grid.Column="2" Watermark="Talkgroup ID" Text="{Binding RecordingTalkgroupFilterText, Mode=TwoWay}" />
              <TextBox Grid.Column="3" Watermark="Subscriber ID" Text="{Binding RecordingSubscriberFilterText, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <StackPanel Spacing="3">
                <TextBlock Classes="caption" Text="Alias" />
                <TextBox Text="{Binding RecordingAliasFilterText, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="caption" Text="Start date" />
                <DatePicker SelectedDate="{Binding RecordingStartDateFilter, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="3">
                <TextBlock Classes="caption" Text="End date" />
                <DatePicker SelectedDate="{Binding RecordingEndDateFilter, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <Expander Header="Visible recording fields" x:CompileBindings="False">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Classes="caption" Text="Choose which metadata fields are shown on each recording card. The defaults match the legacy TAR viewer." TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="4">
                  <CheckBox Content="Time" IsChecked="{Binding ShowRecordingTimeColumn, Mode=TwoWay}" />
                  <CheckBox Content="Duration" IsChecked="{Binding ShowRecordingDurationColumn, Mode=TwoWay}" />
                  <CheckBox Content="Channel" IsChecked="{Binding ShowRecordingChannelColumn, Mode=TwoWay}" />
                  <CheckBox Content="Talkgroup" IsChecked="{Binding ShowRecordingTalkgroupColumn, Mode=TwoWay}" />
                  <CheckBox Content="Source ID" IsChecked="{Binding ShowRecordingSourceIdColumn, Mode=TwoWay}" />
                  <CheckBox Content="Alias" IsChecked="{Binding ShowRecordingAliasColumn, Mode=TwoWay}" />
                  <CheckBox Content="Direction" IsChecked="{Binding ShowRecordingDirectionColumn, Mode=TwoWay}" />
                  <CheckBox Content="Protocol" IsChecked="{Binding ShowRecordingProtocolColumn, Mode=TwoWay}" />
                  <CheckBox Content="System" IsChecked="{Binding ShowRecordingSystemColumn, Mode=TwoWay}" />
                  <CheckBox Content="Encryption" IsChecked="{Binding ShowRecordingEncryptionColumn, Mode=TwoWay}" />
                  <CheckBox Content="Audio diagnostics" IsChecked="{Binding ShowRecordingDiagnosticsColumn, Mode=TwoWay}" />
                </WrapPanel>
                <Button Content="Restore default fields" HorizontalAlignment="Left" Click="HandleResetRecordingColumnsClick" />
              </StackPanel>
            </Expander>
            <TextBlock FontWeight="SemiBold" Text="Channel recording configuration" />
            <ItemsControl ItemsSource="{Binding Systems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SystemViewModel">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" Margin="0,6" />
                    <ItemsControl ItemsSource="{Binding Channels}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ChannelViewModel">
                          <Border Classes="panel">
                            <Grid ColumnDefinitions="*,Auto,220,Auto" ColumnSpacing="8">
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Classes="caption" Text="{Binding DestinationText}" />
                              </StackPanel>
                              <Button Grid.Column="1" Content="{Binding RecordButtonText}" Command="{Binding RecordingCommand}" />
                              <TextBox Grid.Column="2" Watermark="Ignored RIDs, comma separated" Text="{Binding IgnoredSubscriberIdsText, Mode=TwoWay}" />
                              <Button Grid.Column="3" Content="Save ignored RIDs" Tag="{Binding}" Click="HandleSaveIgnoredSubscribersClick" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock FontWeight="SemiBold" Text="Completed recordings" />
            <ItemsControl ItemsSource="{Binding FilteredRecordings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:CallRecordingMetadata">
                  <Border Classes="panel">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="4">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="2">
                          <TextBlock IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingTimeColumn}" Classes="caption" Text="{Binding TimestampText}" />
                          <TextBlock IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingDurationColumn}" Classes="caption" Text="{Binding DurationText}" />
                          <TextBlock IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingChannelColumn}" FontWeight="SemiBold" Text="{Binding ChannelName}" />
                          <StackPanel IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingTalkgroupColumn}" Orientation="Horizontal" Spacing="2">
                            <TextBlock Classes="caption" Text="TG" />
                            <TextBlock Classes="caption" Text="{Binding TalkgroupText}" />
                          </StackPanel>
                          <StackPanel IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingSourceIdColumn}" Orientation="Horizontal" Spacing="2">
                            <TextBlock Classes="caption" Text="RID" />
                            <TextBlock Classes="caption" Text="{Binding SubscriberText}" />
                          </StackPanel>
                          <StackPanel IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingAliasColumn}" Orientation="Horizontal" Spacing="2">
                            <TextBlock Classes="caption" Text="alias" />
                            <TextBlock Classes="caption" Text="{Binding SubscriberAlias}" />
                          </StackPanel>
                          <TextBlock IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingDirectionColumn}" Classes="caption" Text="{Binding Direction}" />
                          <TextBlock IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingProtocolColumn}" Classes="caption" Text="{Binding Protocol}" />
                          <TextBlock IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingSystemColumn}" Classes="caption" Text="{Binding SystemName}" />
                          <TextBlock IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingEncryptionColumn}" Classes="caption" Text="{Binding EncryptionText}" />
                        </WrapPanel>
                        <TextBlock IsVisible="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ShowRecordingDiagnosticsColumn}" Classes="caption" Text="{Binding TechnicalDetailsText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Play" Tag="{Binding}" Click="HandlePlayRecordingClick" />
                      <Button Grid.Column="2" Content="Stop" Click="HandleStopRecordingClick" />
                      <Button Grid.Column="3" Content="Open" Tag="{Binding}" Click="HandleOpenRecordingClick" />
                      <Button Grid.Column="4" Content="Delete" Tag="{Binding}" Click="HandleDeleteRecordingClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="History">
        <ScrollViewer Padding="10"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,260,Auto,Auto" ColumnSpacing="8"><TextBlock Classes="heading" Text="Event History" /><TextBox Grid.Column="1" Watermark="Filter system, channel, RID, protocol" Text="{Binding CallHistoryFilterText, Mode=TwoWay}" /><Button Grid.Column="2" Content="Export CSV…" Click="HandleExportCallHistoryClick" /><Button Grid.Column="3" Content="Clear" Click="HandleClearCallHistoryClick" /></Grid><ItemsControl ItemsSource="{Binding FilteredCallHistory}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:CallHistoryEntry"><Border Classes="panel"><Grid ColumnDefinitions="110,*,120,100,100" ColumnSpacing="8"><TextBlock Text="{Binding TimestampText}" /><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding DisplayChannelText}" /><TextBlock Classes="caption" Text="{Binding RouteText}" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding SystemName}" /><TextBlock Grid.Column="3" Text="{Binding EncryptionText}" /><TextBlock Grid.Column="4" Text="{Binding DurationText}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Groups">
        <ScrollViewer Padding="10">
          <StackPanel Spacing="10">
            <TextBlock Classes="heading" Text="Patch and Multi-select Groups" />
            <ItemsControl ItemsSource="{Binding PatchGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PatchGroupEditorViewModel">
                  <Border Classes="panel">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <TextBlock Classes="caption" Text="{Binding GroupTypeText}" />
                        </StackPanel>
                        <Button Grid.Column="1" IsVisible="{Binding IsMultiSelect}" Content="{Binding PttButtonText}" Tag="{Binding}" Click="HandleMultiSelectPttClick" />
                      </Grid>
                      <Border IsVisible="{Binding HasConflicts}" Background="#4A2C16" BorderBrush="#B86B2B" BorderThickness="1" CornerRadius="4" Padding="8">
                        <TextBlock Text="{Binding ConflictSummary}" TextWrapping="Wrap" />
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsPatchGroup}">
                        <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="One-way" IsChecked="{Binding IsOneWay, Mode=TwoWay}" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:PatchMemberEditorViewModel">
                            <StackPanel Spacing="1">
                              <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsMember, Mode=TwoWay}" IsEnabled="{Binding CanTransmit}" />
                              <TextBlock Classes="caption" IsVisible="{Binding HasConflict}" Text="{Binding ConflictText}" Margin="24,0,0,3" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button HorizontalAlignment="Left" Content="Save group" Tag="{Binding}" Click="HandleApplyPatchGroupClick" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Connections">
        <ScrollViewer Padding="10"><StackPanel Spacing="12"><TextBlock Classes="heading" Text="FNE Connections and Key Status" /><ItemsControl ItemsSource="{Binding Systems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:SystemViewModel"><Border Classes="panel"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="caption" Text="{Binding Endpoint}" /><TextBlock Text="{Binding ConnectionStatus}" /><TextBlock Classes="caption" Text="{Binding PacketDiagnosticsText}" /><TextBlock Classes="caption" Text="{Binding LastPacketText}" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" Content="Connect" Tag="{Binding}" Click="HandleConnectSystemClick" /><Button Grid.Column="2" Content="Disconnect" Tag="{Binding}" Click="HandleDisconnectSystemClick" /><Button Grid.Column="3" Content="Restart" Tag="{Binding}" Click="HandleRestartSystemClick" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock FontWeight="SemiBold" Text="Channel key status" /><ItemsControl ItemsSource="{Binding KeyStatusItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:KeyStatusItemViewModel"><Border Classes="panel"><Grid ColumnDefinitions="*,*,90,90,140" ColumnSpacing="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding ChannelName}" /><TextBlock Classes="caption" Text="{Binding SystemName}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ModeText}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding AlgorithmIdText}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding KeyIdText}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding StatusText}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Classes="caption" Text="Key material is never displayed or logged; only identifiers and availability are shown." IsVisible="{Binding HasNoKeyStatusItems}" /></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="General">
        <ScrollViewer Padding="10"><StackPanel Spacing="10"><TextBlock Classes="heading" Text="Console Settings" /><TextBlock Classes="caption" Text="{Binding SettingsVersionText}" /><CheckBox Content="Toggle global PTT instead of hold-to-talk" IsChecked="{Binding TogglePttMode, Mode=TwoWay}" /><CheckBox Content="Talk permit tone" IsChecked="{Binding TalkPermitTone, Mode=TwoWay}" /><CheckBox Content="Connection chimes" IsChecked="{Binding ConnectionChimes, Mode=TwoWay}" /><CheckBox Content="Mute RX while transmitting" IsChecked="{Binding MuteRxAudioWhileTransmitting, Mode=TwoWay}" /><CheckBox Content="Restore selected channels on startup" IsChecked="{Binding RestoreSelectedChannelsOnStartup, Mode=TwoWay}" /><CheckBox Content="Retain patch state on startup" IsChecked="{Binding RetainPatchStateOnStartup, Mode=TwoWay}" /><CheckBox Content="Dark mode" IsChecked="{Binding DarkMode, Mode=TwoWay}" /><CheckBox Content="Keep window on top" IsChecked="{Binding KeepWindowOnTop, Mode=TwoWay}" /><Separator /><TextBlock FontWeight="SemiBold" Text="Widgets" /><CheckBox Content="Show system status" IsChecked="{Binding ShowSystemStatus, Mode=TwoWay}" /><CheckBox Content="Show channel widgets" IsChecked="{Binding ShowChannels, Mode=TwoWay}" /><CheckBox Content="Show alert buttons" IsChecked="{Binding ShowAlertTones, Mode=TwoWay}" /><CheckBox Content="Lock channel widget positions" IsChecked="{Binding LockWidgets, Mode=TwoWay}" /><Button Content="Reset widget layout" Click="HandleResetLayoutClick" /><Separator /><TextBlock FontWeight="SemiBold" Text="Toolbar clocks" /><TextBlock Classes="caption" Text="Enable slots, choose a UTC offset, and color-code each clock." TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding ToolbarClocks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ToolbarClockViewModel"><Grid ColumnDefinitions="Auto,Auto,150,150,*" ColumnSpacing="8" Margin="0,2"><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" /><TextBlock Grid.Column="1" Text="{Binding SlotLabel}" VerticalAlignment="Center" /><ComboBox Grid.Column="2" ItemsSource="{Binding UtcOffsetOptions}" SelectedItem="{Binding SelectedUtcOffsetOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="local:ToolbarClockUtcOffsetOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox Grid.Column="3" ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColorOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="local:ToolbarClockColorOption"><StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" Background="{Binding ColorBrush}" CornerRadius="3" /><TextBlock Text="{Binding Label}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Grid.Column="4" Classes="caption" Text="{Binding TimeZoneLabel}" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Save toolbar clocks" Click="HandleSaveToolbarClocksClick" /><Separator /><TextBlock FontWeight="SemiBold" Text="Clock" /><CheckBox Content="Use 24-hour time" IsChecked="{Binding ClockUse24HourTime, Mode=TwoWay}" /><CheckBox Content="Show seconds" IsChecked="{Binding ClockShowSeconds, Mode=TwoWay}" /><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="caption" Text="Global PTT key:" /><TextBlock Classes="caption" Text="{Binding GlobalPttKeyText}" /></StackPanel></StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" BorderBrush="#3A4654" BorderThickness="0,1,0,0" Padding="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="caption" Text="{Binding AudioStatusText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Close" Click="HandleCloseClick" /></Grid></Border>
  </Grid>
</Window>
