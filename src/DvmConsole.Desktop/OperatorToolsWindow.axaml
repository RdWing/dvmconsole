<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DvmConsole.Desktop"
        x:Class="DvmConsole.Desktop.OperatorToolsWindow"
        x:DataType="local:MainWindowViewModel"
        Title="Console Settings" Width="1180" Height="780" MinWidth="720" MinHeight="520" Background="{DynamicResource ShellBackgroundBrush}" FontSize="{Binding UiFontSize}"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiHeadingFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Opacity" Value="0.72" /><Setter Property="FontSize" Value="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).UiSmallFontSize}" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="10,6" /></Style>
    <Style Selector="Button.tar-select:pointerover" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding RecordingSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding RecordingSelectionBorderBrush}" /></Style>
    <Style Selector="Button.tar-select:pressed" x:DataType="local:ChannelViewModel"><Setter Property="Background" Value="{Binding RecordingSelectionBrush}" /><Setter Property="BorderBrush" Value="{Binding RecordingSelectionBorderBrush}" /></Style>
    <Style Selector="Border.history-row"><Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="6,4" /><Setter Property="Margin" Value="0,0,0,3" /></Style>
    <Style Selector="Button.history-action"><Setter Property="Padding" Value="7,3" /><Setter Property="MinHeight" Value="0" /></Style>
    <Style Selector="ToggleButton.recorder-system-toggle"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0,6" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="ToggleButton.recorder-system-toggle:pointerover"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="ToggleButton.recorder-system-toggle:pressed"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="ToggleButton.recorder-system-toggle:checked"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="ToggleButton.recorder-system-toggle TextBlock.recorder-system-chevron"><Setter Property="Text" Value="▸" /></Style>
    <Style Selector="ToggleButton.recorder-system-toggle:checked TextBlock.recorder-system-chevron"><Setter Property="Text" Value="▾" /></Style>
    <Style Selector="ListBox.history-list > ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /></Style>
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="True" /><Setter Property="VerticalScrollBarVisibility" Value="Hidden" /></Style>
    <Style Selector="ScrollBar"><Setter Property="AllowAutoHide" Value="True" /><Setter Property="ShowDelay" Value="0:0:0" /><Setter Property="HideDelay" Value="0:0:0.7" /></Style>
  </Window.Styles>

  <LayoutTransformControl LayoutTransform="{Binding UiScaleTransform}">
  <Grid RowDefinitions="*,Auto">
    <TabControl x:Name="ToolTabs" Margin="10">
      <TabItem Header="General">
        <ScrollViewer Margin="10">
          <StackPanel Spacing="10">
            <TextBlock Classes="heading" Text="Console Settings" />
            <TextBlock Classes="caption" Text="{Binding SettingsVersionText}" />
            <TextBlock FontWeight="SemiBold" Text="Appearance" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Spacing="4"><TextBlock Classes="caption" Text="{Binding UiFontSizeText}" /><Slider Minimum="11" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding UiFontSize, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="caption" Text="{Binding UiScaleText}" /><Slider Minimum="0.75" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding UiScale, Mode=TwoWay}" /></StackPanel>
            </Grid>
            <Separator />
            <CheckBox Content="Toggle global PTT instead of hold-to-talk" IsChecked="{Binding TogglePttMode, Mode=TwoWay}" />
            <CheckBox Content="Talk permit tone" IsChecked="{Binding TalkPermitTone, Mode=TwoWay}" />
            <CheckBox Content="Connection chimes" IsChecked="{Binding ConnectionChimes, Mode=TwoWay}" />
            <CheckBox Content="Mute RX while transmitting" IsChecked="{Binding MuteRxAudioWhileTransmitting, Mode=TwoWay}" />
            <CheckBox Content="Restore selected channels on startup" IsChecked="{Binding RestoreSelectedChannelsOnStartup, Mode=TwoWay}" />
            <CheckBox Content="Retain patch state on startup" IsChecked="{Binding RetainPatchStateOnStartup, Mode=TwoWay}" />
            <CheckBox Content="Dark mode" IsChecked="{Binding DarkMode, Mode=TwoWay}" />
            <CheckBox Content="Keep window on top" IsChecked="{Binding KeepWindowOnTop, Mode=TwoWay}" />
            <Separator />
            <TextBlock FontWeight="SemiBold" Text="Widgets" />
            <CheckBox Content="Show system status" IsChecked="{Binding ShowSystemStatus, Mode=TwoWay}" />
            <CheckBox Content="Show channel widgets" IsChecked="{Binding ShowChannels, Mode=TwoWay}" />
            <CheckBox Content="Show alert buttons" IsChecked="{Binding ShowAlertTones, Mode=TwoWay}" />
            <CheckBox Content="Lock channel widget positions" IsChecked="{Binding LockWidgets, Mode=TwoWay}" />
            <Button Content="Reset widget layout" Click="HandleResetLayoutClick" />
            <Separator />
            <TextBlock x:Name="ClockSettingsSection" FontWeight="SemiBold" Text="Toolbar clocks" />
            <TextBlock Classes="caption" Text="Enable slots, choose a UTC offset, and color-code each clock." TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding ToolbarClocks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ToolbarClockViewModel">
                  <Grid ColumnDefinitions="Auto,Auto,150,150,*" ColumnSpacing="8" Margin="0,2">
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" Text="{Binding SlotLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding UtcOffsetOptions}" SelectedItem="{Binding SelectedUtcOffsetOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="local:ToolbarClockUtcOffsetOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColorOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="local:ToolbarClockColorOption"><StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" Background="{Binding ColorBrush}" CornerRadius="3" /><TextBlock Text="{Binding Label}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBlock Grid.Column="4" Classes="caption" Text="{Binding TimeZoneLabel}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Save toolbar clocks" Click="HandleSaveToolbarClocksClick" />
            <Separator />
            <TextBlock FontWeight="SemiBold" Text="Clock" />
            <CheckBox Content="Use 24-hour time" IsChecked="{Binding ClockUse24HourTime, Mode=TwoWay}" />
            <CheckBox Content="Show seconds" IsChecked="{Binding ClockShowSeconds, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="caption" Text="Global PTT key:" /><TextBlock Classes="caption" Text="{Binding GlobalPttKeyText}" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="caption" Text="Active-system PTT key:" /><TextBlock Classes="caption" Text="{Binding ActiveSystemPttKeyText}" /></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Audio">
        <ScrollViewer Margin="10">
          <StackPanel Spacing="12" Margin="0,0,0,20">
            <TextBlock Classes="heading" Text="Audio Settings" />
            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
              <TextBlock Text="Input device" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDevice, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="2" Text="Output device" VerticalAlignment="Center" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Refresh devices" Command="{Binding RefreshAudioDevicesCommand}" />
                <Button Content="Test talk permit tone" Click="HandleTestPermitToneClick" />
                <Button Content="Request macOS microphone access" Click="HandleRequestMacOsMicrophonePermissionClick" IsVisible="{Binding IsMacOsPermissionRequestAvailable}" />
              </StackPanel>
            </Grid>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="RX audio processing options" />
                <TextBlock Classes="caption"
                           Text="Configure each decoded digital voice mode independently."
                           TextWrapping="Wrap" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="125,44,116,44,116,116,44,116,116,116" ColumnSpacing="6">
                      <TextBlock Text="Mode" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="HPF" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="HPF Hz" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="Peak" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="Peak Hz" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="Peak dB" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="Comp" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="7" Text="Ratio" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="8" Text="Thresh dBFS" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="9" Text="Makeup dB" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RxAudioProcessingModes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:RxAudioProcessingModeViewModel">
                          <Grid ColumnDefinitions="125,44,116,44,116,116,44,116,116,116" ColumnSpacing="6" Margin="0,2">
                            <TextBlock Text="{Binding ModeName}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding HighPassFilterEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                            <NumericUpDown Grid.Column="2" Minimum="0" Maximum="500" Increment="25" FormatString="0" ClipValueToMinMax="True" Value="{Binding HighPassFrequencyHz, Mode=TwoWay}" IsEnabled="{Binding HighPassFilterEnabled}" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding PeakingFilterEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                            <NumericUpDown Grid.Column="4" Minimum="250" Maximum="3000" Increment="25" FormatString="0" ClipValueToMinMax="True" Value="{Binding PeakingFrequencyHz, Mode=TwoWay}" IsEnabled="{Binding PeakingFilterEnabled}" />
                            <NumericUpDown Grid.Column="5" Minimum="-10" Maximum="10" Increment="0.5" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding PeakingGainDb, Mode=TwoWay}" IsEnabled="{Binding PeakingFilterEnabled}" />
                            <CheckBox Grid.Column="6" IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                            <NumericUpDown Grid.Column="7" Minimum="1" Maximum="10" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding CompressorRatio, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}" />
                            <NumericUpDown Grid.Column="8" Minimum="-40" Maximum="0" Increment="1" FormatString="0" ClipValueToMinMax="True" Value="{Binding CompressorThresholdDbfs, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}" />
                            <NumericUpDown Grid.Column="9" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" ClipValueToMinMax="True" Value="{Binding CompressorMakeupGainDb, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Apply RX options" Command="{Binding ApplyRxAudioProcessingOptionsCommand}" />
                  <TextBlock Classes="caption" Text="Defaults: 250 Hz HPF, 2.5 kHz / +3 dB peak, compressor off (3:1, -18 dBFS, +3 dB when enabled)." VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Microphone processing" />
                <TextBlock Classes="caption"
                           Text="DVM Console processing is the standard macOS microphone path. It avoids the additional Apple full-duplex processing latency while retaining console gain, EQ, and optional AGC."
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsAppleVoiceProcessingPlatformAvailable}" />
                <Grid ColumnDefinitions="Auto,260,*" ColumnSpacing="8"
                      IsVisible="{Binding !IsAppleVoiceProcessingPlatformAvailable}">
                  <TextBlock Text="Mode" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding AudioProcessingModeOptions}" SelectedItem="{Binding SelectedAudioProcessingMode, Mode=TwoWay}" />
                </Grid>
                <TextBlock Classes="caption" Text="{Binding AudioProcessingDescription}" TextWrapping="Wrap"
                           IsVisible="{Binding !IsAppleVoiceProcessingPlatformAvailable}" />
                <WrapPanel ItemSpacing="16" LineSpacing="8" IsEnabled="{Binding IsDvmConsoleProcessingSelected}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Gain" VerticalAlignment="Center" /><NumericUpDown Width="116" Minimum="0.25" Maximum="3.0" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Text="{Binding AudioInputGainText, Mode=TwoWay}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Low dB" VerticalAlignment="Center" /><NumericUpDown Width="116" Minimum="-12" Maximum="12" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Text="{Binding AudioInputLowGainText, Mode=TwoWay}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Mid dB" VerticalAlignment="Center" /><NumericUpDown Width="116" Minimum="-12" Maximum="12" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Text="{Binding AudioInputMidGainText, Mode=TwoWay}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="High dB" VerticalAlignment="Center" /><NumericUpDown Width="116" Minimum="-12" Maximum="12" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Text="{Binding AudioInputHighGainText, Mode=TwoWay}" /></StackPanel>
                </WrapPanel>
                <WrapPanel ItemSpacing="10" LineSpacing="8">
                  <CheckBox Content="Automatic gain control" IsChecked="{Binding AudioInputAgcEnabled, Mode=TwoWay}" IsEnabled="{Binding IsDvmConsoleProcessingSelected}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsAgcTargetEnabled}"><TextBlock Text="AGC target (dBFS)" VerticalAlignment="Center" /><NumericUpDown Width="136" Minimum="-40" Maximum="-12" Increment="0.1" FormatString="0.0" ClipValueToMinMax="True" Text="{Binding AudioInputAgcTargetDbfsText, Mode=TwoWay}" /></StackPanel>
                  <CheckBox Content="Keep transmit microphone warm" IsChecked="{Binding KeepTransmitMicrophoneWarm, Mode=TwoWay}" />
                  <Button Content="Apply" Command="{Binding ApplyAudioInputSettingsCommand}" />
                </WrapPanel>
                <TextBlock Classes="caption" Text="The default AGC target is -25 dBFS. Use a more-negative value for a quieter target; accepted range is -40 to -12 dBFS." TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="Bluetooth PTT uses the optimized DVM Console audio path. Most headsets should not need Keep Mic Warm; enable it only if a particular headset still has unacceptable cold-start delay, because it may lower output audio quality while enabled." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Microphone presets" />
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="240" Watermark="Preset name" Text="{Binding AudioInputPresetNameText, Mode=TwoWay}" /><Button Content="Save current" Click="HandleSaveAudioInputPresetClick" /></StackPanel>
                <ItemsControl ItemsSource="{Binding AudioInputPresets}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:AudioInputPresetViewModel"><Border Classes="panel"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Use" Tag="{Binding}" Click="HandleUseAudioInputPresetClick" /><Button Grid.Column="2" Content="Delete" Tag="{Binding}" Click="HandleDeleteAudioInputPresetClick" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Per-channel output routes" />
                <TextBlock Classes="caption" Text="Each channel follows the main output device above. Choose a different device only for an explicit channel override. Balance places RX audio from left through center to right and applies immediately." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Systems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SystemViewModel">
                      <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Channels}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ChannelViewModel">
                              <Grid ColumnDefinitions="*,220,180,72,Auto" ColumnSpacing="8" Margin="0,2">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDeviceOptions}" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <local:NeutralSnapSlider Grid.Column="2" Minimum="-1" Maximum="1" NeutralValue="0" TickFrequency="0.1" Value="{Binding StereoBalance, Mode=TwoWay}" ToolTip.Tip="Stereo balance: -1 left, 0 center, +1 right" />
                                <TextBlock Grid.Column="3" Text="{Binding StereoBalanceText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Content="Save route" Tag="{Binding}" Click="HandleSaveOutputDeviceClick" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Tones">
        <ScrollViewer Margin="10">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Tones and DTMF" />
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="DTMF" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="180" Watermark="Digits" Text="{Binding DtmfDigits, Mode=TwoWay}" /><Button Content="Send" Command="{Binding SendDtmfCommand}" /><TextBox Width="200" Watermark="Preset name" Text="{Binding DtmfPresetName, Mode=TwoWay}" /><Button Content="Save preset" Command="{Binding SaveDtmfPresetCommand}" /></StackPanel><ItemsControl ItemsSource="{Binding DtmfPresets}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:DtmfPresetViewModel"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4"><TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Use" Tag="{Binding}" Click="HandleUseDtmfPresetClick" /><Button Grid.Column="2" Content="Send" Tag="{Binding}" Click="HandleSendDtmfPresetClick" /><Button Grid.Column="3" Content="Delete" Tag="{Binding}" Click="HandleDeleteDtmfPresetClick" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Alert / QCII tone pattern" />
                <TextBlock Classes="caption" Text="Build an ordered pattern of 300–2500 Hz tones and silent holds. Every step remains in one call." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ToneSequenceSteps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ToneSequenceStepViewModel">
                      <Grid ColumnDefinitions="Auto,110,110,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,3">
                        <CheckBox Content="Silence" IsChecked="{Binding IsSilence, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Watermark="300–2500 Hz" Text="{Binding FrequencyText, Mode=TwoWay}" />
                        <TextBox Grid.Column="2" Watermark="Seconds" Text="{Binding DurationText, Mode=TwoWay}" />
                        <Button Grid.Column="3" Content="↑" Tag="{Binding}" Click="HandleMoveToneStepUpClick" />
                        <Button Grid.Column="4" Content="↓" Tag="{Binding}" Click="HandleMoveToneStepDownClick" />
                        <Button Grid.Column="5" Content="Remove" Tag="{Binding}" Click="HandleRemoveToneStepClick" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Add tone" Click="HandleAddToneStepClick" />
                  <Button Content="Add silence" Click="HandleAddSilenceStepClick" />
                  <Button Content="Send pattern" Command="{Binding SendToneCommand}" />
                  <TextBox Width="200" Watermark="Preset name" Text="{Binding TonePresetName, Mode=TwoWay}" />
                  <Button Content="Save preset" Command="{Binding SaveTonePresetCommand}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding TonePresets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:TonePresetViewModel">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4">
                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Use" Tag="{Binding}" Click="HandleUseTonePresetClick" />
                        <Button Grid.Column="2" Content="Send" Tag="{Binding}" Click="HandleSendTonePresetClick" />
                        <Button Grid.Column="3" Content="Delete" Tag="{Binding}" Click="HandleDeleteTonePresetClick" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="Quick Call II / page" /><TextBlock Classes="caption" Text="Tone A is sent for 1 second, then tone B for 3 seconds in the same call. Frequencies must be 300–2500 Hz. Arm PAGE on the channel cards to choose targets; PAGE clears after a successful send." TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="110" Watermark="Tone A Hz" Text="{Binding QuickCallToneAText, Mode=TwoWay}" /><TextBox Width="110" Watermark="Tone B Hz" Text="{Binding QuickCallToneBText, Mode=TwoWay}" /><Button Content="Send QCII page" Click="HandleSendQuickCallClick" /></StackPanel></StackPanel></Border>
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="Custom alert assets" /><TextBlock Classes="caption" Text="Import PCM WAV, MPEG, or Ogg Opus audio up to 30 seconds. Audio is decoded to 8 kHz mono; sustained single tones use the optimized P25 tone path while all other audio uses the normal voice encoder." TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="240" Watermark="Display name (optional)" Text="{Binding AlertToneNameText, Mode=TwoWay}" /><Button Content="Import audio…" Click="HandleImportAlertToneClick" /></StackPanel><ItemsControl ItemsSource="{Binding AlertTones}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:AlertToneViewModel"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4"><StackPanel><TextBlock Text="{Binding DisplayText}" /><TextBlock Classes="caption" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" Content="Send" Tag="{Binding}" Click="HandleSendAlertToneClick" /><Button Grid.Column="2" Content="Delete" Tag="{Binding}" Click="HandleDeleteAlertToneClick" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <TextBlock Classes="caption" Text="DTMF, generated tones, presets, and alert assets transmit to all ALERT-armed channels. QCII transmits to all PAGE-armed channels." TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Streams">
        <ScrollViewer Margin="10"><StackPanel Spacing="10"><TextBlock Classes="heading" Text="Web Streams" /><ItemsControl ItemsSource="{Binding WebStreams}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:WebStreamViewModel"><Border Classes="panel"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="caption" Text="{Binding StatusText}" /></StackPanel><Button Grid.Column="1" Content="{Binding ToggleButtonText}" Command="{Binding ToggleCommand}" /><Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,180,Auto,220,Auto" ColumnSpacing="8"><TextBlock Text="Volume" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="4" Value="{Binding Volume, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="Output" VerticalAlignment="Center" /><ComboBox Grid.Column="3" ItemsSource="{Binding OutputDeviceOptions}" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="4" Content="Save route" Tag="{Binding}" Click="HandleSaveWebStreamOutputDeviceClick" /></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Classes="caption" Text="Streams are loaded from the active codeplug." /></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Recorder">
        <ScrollViewer Margin="10">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Talkgroup Audio Recorder" />
            <Border Classes="panel">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Storage" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding RecordingRootPathText, Mode=TwoWay}" />
                <Button Grid.Column="2" Content="Browse…" Click="HandleChooseRecordingRootClick" />
                <Button Grid.Column="3" Content="Apply folder" Click="HandleApplyRecordingRootClick" />
              </Grid>
            </Border>
            <Grid ColumnDefinitions="Auto,90,Auto,*" ColumnSpacing="8">
              <TextBlock Text="Retention days" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding RecordingRetentionDaysText, Mode=TwoWay}" />
              <Button Grid.Column="2" Content="Apply and prune" Command="{Binding ApplyRecordingRetentionCommand}" />
              <TextBlock Grid.Column="3" Classes="caption" Text="Completed recordings, search, and playback are available in History." TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <TextBlock FontWeight="SemiBold" Text="Channel recording configuration" />
            <ItemsControl ItemsSource="{Binding Systems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SystemViewModel">
                  <StackPanel Margin="0,2,0,6">
                    <ToggleButton x:Name="SystemToggle" Classes="recorder-system-toggle" IsChecked="True">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Classes="recorder-system-chevron" Opacity="0.72" />
                      </Grid>
                    </ToggleButton>
                    <ItemsControl ItemsSource="{Binding Channels}" IsVisible="{Binding IsChecked, ElementName=SystemToggle}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ChannelViewModel">
                          <Border Classes="panel">
                            <Grid ColumnDefinitions="*,Auto,220,Auto" ColumnSpacing="8">
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Classes="caption" Text="{Binding DestinationText}" />
                              </StackPanel>
                              <Button Grid.Column="1" Classes="tar-select" Content="{Binding RecordingConfigurationButtonText}" Background="{Binding RecordingSelectionBrush}" BorderBrush="{Binding RecordingSelectionBorderBrush}" Command="{Binding RecordingCommand}" />
                              <TextBox Grid.Column="2" Watermark="Ignored RIDs, comma separated" Text="{Binding IgnoredSubscriberIdsText, Mode=TwoWay}" />
                              <Button Grid.Column="3" Content="Save ignored RIDs" Tag="{Binding}" Click="HandleSaveIgnoredSubscribersClick" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="History">
        <Grid Margin="10" RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Classes="heading" Text="Event History" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Watermark="Search events, calls, aliases, IDs, filenames, and diagnostics" Text="{Binding CallHistoryFilterText, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="Export CSV…" Click="HandleExportCallHistoryClick" />
            <Button Grid.Column="3" Content="Clear session" Click="HandleClearCallHistoryClick" />
          </Grid>
          <Expander Grid.Row="1" Header="Advanced filters">
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <Grid ColumnDefinitions="Auto,140,Auto,140,Auto,140,*" ColumnSpacing="8">
                <TextBlock Text="Direction" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding RecordingDirectionFilters}" SelectedItem="{Binding RecordingDirectionFilter, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Text="Protocol" VerticalAlignment="Center" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding RecordingProtocolFilters}" SelectedItem="{Binding RecordingProtocolFilter, Mode=TwoWay}" />
                <TextBlock Grid.Column="4" Text="Encryption" VerticalAlignment="Center" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding RecordingEncryptionFilters}" SelectedItem="{Binding RecordingEncryptionFilter, Mode=TwoWay}" />
                <Button Grid.Column="6" Content="Clear filters" HorizontalAlignment="Right" Click="HandleClearHistoryFiltersClick" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                <TextBox Watermark="System" Text="{Binding RecordingSystemFilterText, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Watermark="Channel" Text="{Binding RecordingChannelFilterText, Mode=TwoWay}" />
                <TextBox Grid.Column="2" Watermark="Talkgroup ID" Text="{Binding RecordingTalkgroupFilterText, Mode=TwoWay}" />
                <TextBox Grid.Column="3" Watermark="Subscriber ID" Text="{Binding RecordingSubscriberFilterText, Mode=TwoWay}" />
                <TextBox Grid.Column="4" Watermark="Alias" Text="{Binding RecordingAliasFilterText, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                <TextBlock Text="From" VerticalAlignment="Center" />
                <DatePicker Grid.Column="1" MinWidth="240" SelectedDate="{Binding RecordingStartDateFilter, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Text="Through" VerticalAlignment="Center" />
                <DatePicker Grid.Column="3" MinWidth="240" SelectedDate="{Binding RecordingEndDateFilter, Mode=TwoWay}" />
                <TextBlock Grid.Column="4" Classes="caption" Text="{Binding HistoryFilterSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Expander>
          <ListBox x:Name="HistoryList" Grid.Row="2" Classes="history-list" ItemsSource="{Binding FilteredCallHistory}" Background="Transparent" BorderThickness="0" AutoScrollToSelectedItem="False" ScrollViewer.BringIntoViewOnFocusChange="False">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:CallHistoryEntry">
                <Border Classes="history-row">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="80,*,220,100,75,90,55" ColumnSpacing="7" RowSpacing="1">
                    <TextBlock Text="{Binding TimestampText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding DisplayChannelText}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding HasRecording}">
                      <Button Classes="history-action" Content="Play" Tag="{Binding}" IsEnabled="{Binding HasPlayableRecording}" ToolTip.Tip="Play validated TAR recording" Click="HandlePlayCallHistoryRecordingClick" />
                      <Button Classes="history-action" Content="Stop" Click="HandleStopRecordingClick" />
                      <Button Classes="history-action" Content="Open" Tag="{Binding Recording}" IsEnabled="{Binding HasPlayableRecording}" ToolTip.Tip="Show recording in Finder or Explorer" Click="HandleOpenRecordingClick" />
                      <Button Classes="history-action" Content="Delete" Tag="{Binding Recording}" Click="HandleDeleteRecordingClick" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding SystemName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding DirectionText}" />
                    <TextBlock Grid.Column="5" Text="{Binding ProtocolText}" />
                    <TextBlock Grid.Column="6" Text="{Binding DurationText}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="{Binding DateText}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="{Binding RouteText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Classes="caption" Text="{Binding EncryptionText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" Classes="caption" Text="{Binding RecordingFileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RecordingPath}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Groups">
        <ScrollViewer Margin="10">
          <StackPanel Spacing="10">
            <TextBlock Classes="heading" Text="Patch and Multi-select Groups" />
            <ItemsControl ItemsSource="{Binding PatchGroups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemWidth="520" ItemSpacing="10" LineSpacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PatchGroupEditorViewModel">
                  <Border Classes="panel">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <TextBlock Classes="caption" Text="{Binding GroupTypeText}" />
                        </StackPanel>
                        <Button Grid.Column="1" IsVisible="{Binding IsMultiSelect}" Content="{Binding PttButtonText}" Tag="{Binding}" Click="HandleMultiSelectPttClick" />
                      </Grid>
                      <Border IsVisible="{Binding HasConflicts}" HorizontalAlignment="Left" Background="#4A2C16" BorderBrush="#B86B2B" BorderThickness="1" CornerRadius="4" Padding="8">
                        <TextBlock Text="{Binding ConflictSummary}" TextWrapping="Wrap" />
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsPatchGroup}">
                        <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="One-way" IsChecked="{Binding IsOneWay, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Spacing="4" IsVisible="{Binding IsOneWay}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <TextBlock VerticalAlignment="Center" Text="Source" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="local:PatchMemberEditorViewModel">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding OneWayDestinationSummary}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Expander Header="{Binding MemberEditorHeader}">
                        <ItemsControl ItemsSource="{Binding Members}" Margin="0,6,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PatchMemberEditorViewModel">
                              <StackPanel Spacing="1">
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsMember, Mode=TwoWay}" IsEnabled="{Binding IsSelectionEnabled}" />
                                <TextBlock Classes="caption" IsVisible="{Binding HasConflict}" Text="{Binding ConflictText}" Margin="24,0,0,3" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                      <Button HorizontalAlignment="Left" Content="Save group" Tag="{Binding}" Click="HandleApplyPatchGroupClick" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Connections">
        <ScrollViewer x:Name="ConnectionsScrollViewer" Margin="10">
          <StackPanel Spacing="12" Margin="0,0,0,20">
            <TextBlock Classes="heading" Text="FNE Connections and Key Status" />
            <ItemsControl ItemsSource="{Binding Systems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SystemViewModel">
                  <Border Classes="panel">
                    <StackPanel Spacing="6">
                      <WrapPanel ItemSpacing="16" LineSpacing="8">
                        <StackPanel MinWidth="220">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <TextBlock Classes="caption" Text="{Binding Endpoint}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                          <TextBlock Classes="caption" FontWeight="SemiBold" Text="RX jitter" />
                          <ItemsControl ItemsSource="{Binding RxJitterBufferModes}"
                                        ToolTip.Tip="Fixed or adaptive packet-aligned receive delay. Adaptive learns per connection and protocol; changes save and apply immediately.">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:RxJitterBufferModeViewModel">
                                <StackPanel Width="136" Spacing="1">
                                  <TextBlock Classes="caption" Text="{Binding ModeName}" />
                                  <ComboBox MinHeight="0"
                                            Padding="6,3"
                                            ItemsSource="{Binding Options}"
                                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                      <DataTemplate x:DataType="local:RxJitterBufferOption">
                                        <TextBlock Text="{Binding Label}" />
                                      </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                  </ComboBox>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                          <Button Content="{Binding ConnectionButtonText}" Tag="{Binding}" Click="HandleToggleSystemConnectionClick" />
                          <Button Content="Restart" Tag="{Binding}" Click="HandleRestartSystemClick" />
                        </StackPanel>
                      </WrapPanel>

                      <TextBlock Classes="caption" Text="{Binding AdaptiveJitterLearnedText}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding JitterBufferEffectivenessText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ConnectionStatus}" />
                      <TextBlock Classes="caption" Text="{Binding TrafficTotalsText}" />
                      <TextBlock Classes="caption" Text="{Binding StreamTrafficText}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding ConnectionHealthText}" TextWrapping="Wrap" />

                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EncryptionKeyStatusSection" FontWeight="SemiBold" Text="Channel key status" />
            <ItemsControl ItemsSource="{Binding KeyStatusItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:KeyStatusItemViewModel">
                  <Border Classes="panel">
                    <Grid ColumnDefinitions="*,*,90,90,140" ColumnSpacing="8">
                      <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding ChannelName}" /><TextBlock Classes="caption" Text="{Binding SystemName}" /></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding ModeText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding AlgorithmIdText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding KeyIdText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding StatusText}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption" Text="Key material is never displayed or logged; only identifiers and availability are shown." IsVisible="{Binding HasNoKeyStatusItems}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="PTT">
        <ScrollViewer Margin="10">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Global PTT Settings" />
            <TextBlock Classes="caption" Text="Global PTT and optional serial hardware operate every channel selected with TX. Active-system PTT limits the selected channels to the system tab that is active when PTT starts." TextWrapping="Wrap" />
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Keyboard PTT" />
                <Grid ColumnDefinitions="Auto,180,Auto" ColumnSpacing="8">
                  <TextBlock Text="Global PTT key" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding GlobalPttKeyOptions}" SelectedItem="{Binding SelectedGlobalPttKey, Mode=TwoWay}" />
                  <Button Grid.Column="2" Content="Apply" Click="HandleApplyGlobalPttKeyClick" />
                </Grid>
                <Grid ColumnDefinitions="Auto,180,Auto" ColumnSpacing="8">
                  <TextBlock Text="Active-system PTT key" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding GlobalPttKeyOptions}" SelectedItem="{Binding SelectedActiveSystemPttKey, Mode=TwoWay}" />
                  <Button Grid.Column="2" Content="Apply" Click="HandleApplyActiveSystemPttKeyClick" />
                </Grid>
                <CheckBox Content="Toggle keyboard PTT instead of hold-to-talk" IsChecked="{Binding TogglePttMode, Mode=TwoWay}" />
                <Button Content="Request macOS keyboard access" HorizontalAlignment="Left" Click="HandleRequestMacOsKeyboardPermissionClick" IsVisible="{Binding IsMacOsPermissionRequestAvailable}" />
                <TextBlock Classes="caption" Text="Each keyboard key must be unique. Both bindings use the same hold-to-talk or toggle mode." TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="Serial hardware PTT" />
                <CheckBox Content="Enable serial hardware PTT" IsChecked="{Binding SerialPttEnabled, Mode=TwoWay}" />
                <CheckBox Content="Limit serial PTT to TX-selected resources in the active system" IsChecked="{Binding SerialPttActiveSystemOnly, Mode=TwoWay}" IsEnabled="{Binding SerialPttEnabled}" />
                <Grid ColumnDefinitions="Auto,*,Auto,160" ColumnSpacing="8">
                  <TextBlock Text="Device" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding SerialPttPortOptions}" SelectedItem="{Binding SerialPttPortName, Mode=TwoWay}" IsEnabled="{Binding SerialPttEnabled}" />
                  <TextBlock Grid.Column="2" Text="Baud" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="3" ItemsSource="{Binding SerialPttBaudRates}" SelectedItem="{Binding SerialPttBaudRate, Mode=TwoWay}" IsEnabled="{Binding SerialPttEnabled}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Refresh devices" Click="HandleRefreshSerialPttDevicesClick" />
                  <Button Content="Apply" Click="HandleApplySerialPttSettingsClick" />
                </StackPanel>
                <TextBlock Text="{Binding SerialPttStatusText}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="The device must send one state per line: on, 1, pressed, or ptt=on to key; off, 0, released, or ptt=off to release. Device removal always releases PTT." TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" BorderBrush="#3A4654" BorderThickness="0,1,0,0" Padding="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="caption" Text="{Binding AudioStatusText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Close" Click="HandleCloseClick" /></Grid></Border>
  </Grid>
  </LayoutTransformControl>
</Window>
