<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DvmConsole.Desktop</RootNamespace>
    <AssemblyName>DvmConsole</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/DVMConsole.ico</ApplicationIcon>
    <Authors>RdWing</Authors>
    <Company>RdWing</Company>
    <Product>DVM Console NEO</Product>
    <AssemblyTitle>DVM Console NEO</AssemblyTitle>
    <Copyright>Copyright © 2025-2026 RdWing</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RdWing/dvmconsole</RepositoryUrl>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DvmConsoleTargetPlatform)' == 'macos'">
    <DefineConstants>$(DefineConstants);DVMCONSOLE_MACOS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DvmConsoleTargetPlatform)' == 'windows'">
    <DefineConstants>$(DefineConstants);DVMCONSOLE_WINDOWS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!-- Rooted reflection-heavy dependencies are preserved in full, so their
         aggregate IL2104 diagnostics do not indicate removed functionality. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/TaskObservation.cs" Link="Threading/TaskObservation.cs" />
    <Using Include="DvmConsole.Threading" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" Condition="'$(DvmConsoleTargetPlatform)' == ''" />
    <PackageReference Include="Avalonia.Native" Version="11.3.18"
                      Condition="'$(DvmConsoleTargetPlatform)' == 'macos'" />
    <PackageReference Include="Avalonia.Win32" Version="11.3.18" Condition="'$(DvmConsoleTargetPlatform)' == 'windows'" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.18" Condition="'$(DvmConsoleTargetPlatform)' != ''" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Markdown.Avalonia" Version="11.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DvmConsole.Application/DvmConsole.Application.csproj" />
    <ProjectReference Include="../DvmConsole.Audio.Abstractions/DvmConsole.Audio.Abstractions.csproj" />
    <ProjectReference Include="../DvmConsole.Audio.Core/DvmConsole.Audio.Core.csproj" />
    <ProjectReference Include="../DvmConsole.Audio.Desktop/DvmConsole.Audio.Desktop.csproj" />
    <ProjectReference Include="../DvmConsole.Configuration.Yaml/DvmConsole.Configuration.Yaml.csproj" />
    <ProjectReference Include="../DvmConsole.Ptt.Abstractions/DvmConsole.Ptt.Abstractions.csproj" />
    <ProjectReference Include="../DvmConsole.Ptt.Desktop/DvmConsole.Ptt.Desktop.csproj" />
    <ProjectReference Include="../DvmConsole.Presentation/DvmConsole.Presentation.csproj" />
    <ProjectReference Include="../DvmConsole.Storage/DvmConsole.Storage.csproj" />
    <ProjectReference Include="../DvmConsole.Core/DvmConsole.Core.csproj" />
    <ProjectReference Include="../DvmConsole.FneClient/DvmConsole.FneClient.csproj" />
    <ProjectReference Include="../DvmConsole.Media/DvmConsole.Media.csproj" />
    <ProjectReference Include="../DvmConsole.Operations/DvmConsole.Operations.csproj" />
    <ProjectReference Include="../DvmConsole.Vocoder.Abstractions/DvmConsole.Vocoder.Abstractions.csproj" />
    <ProjectReference Include="../DvmConsole.Vocoder.Native/DvmConsole.Vocoder.Native.csproj" />
  </ItemGroup>

  <!-- These UI/configuration dependencies use runtime discovery internally.
       Keep them intact during partial linking; application and framework code
       can still be reduced without risking Markdown, XAML, SVG, or YAML data. -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="AvaloniaEdit" />
    <TrimmerRootAssembly Include="Avalonia.DesignerSupport" />
    <TrimmerRootAssembly Include="ExCSS" />
    <TrimmerRootAssembly Include="HtmlAgilityPack" />
    <TrimmerRootAssembly Include="Markdown.Avalonia" />
    <TrimmerRootAssembly Include="Markdown.Avalonia.Html" />
    <TrimmerRootAssembly Include="Markdown.Avalonia.SyntaxHigh" />
    <TrimmerRootAssembly Include="Svg.Custom" />
    <TrimmerRootAssembly Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/DVMConsole.png" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/user-guide/**/*.md"
          Link="Documentation/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../configs/codeplug.demo.yml"
          Link="Demo/codeplug.yml"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../configs/keys.demo.clear"
          Link="Demo/keys.clear"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../configs/aliases.demo.yml"
          Link="Demo/aliases.yml"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
