<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DvmConsole.Desktop.AboutWindow"
        Title="About DVM Console" Width="500" Height="330" CanResize="False"
        Background="{DynamicResource ShellBackgroundBrush}"
        Icon="avares://DvmConsole/Assets/DVMConsole.png"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Image Source="avares://DvmConsole/Assets/DVMConsole.png" Width="64" Height="64" />
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Digital Voice Modem" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Desktop Dispatch Console" FontSize="14" />
        <TextBlock x:Name="versionText" Classes="muted" />
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
      <StackPanel Spacing="7">
        <TextBlock Text="Copyright © 2025–2026 RdWing." TextWrapping="Wrap" />
        <TextBlock Text="Licensed under the GNU Affero General Public License v3.0 (AGPL-3.0-only). Distributed without warranty." TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="2" Classes="muted" Text="This software must never be used for public-safety or life-safety critical applications." TextWrapping="Wrap" VerticalAlignment="Top" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Repository" Click="HandleRepositoryClick" />
      <Button Content="License" Click="HandleLicenseClick" />
      <Button Content="Close" Click="HandleCloseClick" MinWidth="78" />
    </StackPanel>
  </Grid>
</Window>
