<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Rules are phased in explicitly in src/.editorconfig so SDK updates
         cannot silently expand the warnings-as-errors surface. Developer-only
         probes keep the same small correctness baseline. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>None</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Keep tags in the form v$(Version). -->
    <VersionPrefix>0.4.2</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>0.4.2.0</AssemblyVersion>
    <FileVersion>0.4.2.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
