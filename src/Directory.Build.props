<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Analyzer rules are phased in explicitly in src/.editorconfig so a new
         SDK cannot silently expand the warnings-as-errors surface. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>None</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Keep tags in the form v$(Version). -->
    <VersionPrefix>0.3.8</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>0.3.8.0</AssemblyVersion>
    <FileVersion>0.3.8.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
