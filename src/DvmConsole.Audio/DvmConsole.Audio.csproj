<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DvmConsole.Audio</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DvmConsoleTargetPlatform)' == 'macos'">
    <DefineConstants>$(DefineConstants);DVMCONSOLE_MACOS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DvmConsoleTargetPlatform)' == 'windows'">
    <DefineConstants>$(DefineConstants);DVMCONSOLE_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NLayer" Version="2.0.1" />
    <PackageReference Include="NAudio.Wasapi" Version="3.0.1"
                      Condition="'$(DvmConsoleTargetPlatform)' != 'macos'" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(DvmConsoleTargetPlatform)' == 'macos'">
    <Compile Remove="WindowsAudioBackend.cs;WindowsWasapiCapture.cs;WindowsWasapiPlayback.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(DvmConsoleTargetPlatform)' == 'windows'">
    <Compile Remove="MacCoreAudioBackend.cs;MacCoreAudioEndpoints.cs;NativeCoreAudioApi.cs;PcmWriteProgressWatchdog.cs;VoiceProcessingSessionRegistry.cs" />
  </ItemGroup>
</Project>
