<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DvmConsole.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DvmConsole.Configuration.Yaml" />
    <InternalsVisibleTo Include="DvmConsole.Application" />
    <InternalsVisibleTo Include="DvmConsole.Mobile" />
    <InternalsVisibleTo Include="DvmConsole.iOS" />
    <InternalsVisibleTo Include="DvmConsole.Presentation" />
    <InternalsVisibleTo Include="DvmConsole" />
    <InternalsVisibleTo Include="DvmConsole.Storage" />
    <InternalsVisibleTo Include="DvmConsole.Media" />
    <InternalsVisibleTo Include="DvmConsole.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>
</Project>
