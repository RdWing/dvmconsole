<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DvmConsole.Media</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/TaskObservation.cs" Link="Threading/TaskObservation.cs" />
    <Using Include="DvmConsole.Threading" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DvmConsole.Audio.Abstractions/DvmConsole.Audio.Abstractions.csproj" />
    <ProjectReference Include="../DvmConsole.Audio.Core/DvmConsole.Audio.Core.csproj" />
    <ProjectReference Include="../DvmConsole.Core/DvmConsole.Core.csproj" />
    <!-- Temporary Phase 2 allowlist: protocol codecs still consume the pinned
         fnecore primitives, but no network-client/session types cross into Media. -->
    <ProjectReference Include="../DvmConsole.Fne/DvmConsole.Fne.csproj" />
    <ProjectReference Include="../DvmConsole.Vocoder.Abstractions/DvmConsole.Vocoder.Abstractions.csproj" />
  </ItemGroup>
</Project>
