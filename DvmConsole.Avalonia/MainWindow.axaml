<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DvmConsole.Avalonia.ViewModels"
        xmlns:svc="using:DvmConsole.Avalonia.Services"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="DvmConsole.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DVM Console"
        Width="1180" Height="760"
        MinWidth="920" MinHeight="680"
        Background="#0B1114"
        Foreground="#EFF7F5"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="App">
                <NativeMenu>
                    <NativeMenuItem Header="Quit" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Styles>
        <Style Selector="TextBlock.kicker">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#5FE1D2" />
            <Setter Property="LetterSpacing" Value="2" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Foreground" Value="#8EA3A3" />
        </Style>
        <Style Selector="TextBlock.data-label">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#8EA3A3" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="TextBlock.data-value">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#111B1F" />
            <Setter Property="BorderBrush" Value="#24373A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.channel-card">
            <Setter Property="Background" Value="#142126" />
            <Setter Property="BorderBrush" Value="#2A4548" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.channel-card.selected">
            <Setter Property="BorderBrush" Value="#4E8A8C" />
        </Style>
        <Style Selector="Border.channel-card.primary">
            <Setter Property="BorderBrush" Value="#F3B562" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Ellipse.activity">
            <Setter Property="Fill" Value="#536769" />
        </Style>
        <Style Selector="Ellipse.activity.receiving">
            <Setter Property="Fill" Value="#5FE1D2" />
        </Style>
        <Style Selector="Ellipse.activity.receiving.encrypted">
            <Setter Property="Fill" Value="#F3B562" />
        </Style>
        <Style Selector="Button.ptt-button">
            <Setter Property="Background" Value="#1A262B" />
            <Setter Property="BorderBrush" Value="#2A4548" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#8EA3A3" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Button.ptt-button.engaged">
            <Setter Property="Background" Value="#0F3B38" />
            <Setter Property="BorderBrush" Value="#5FE1D2" />
            <Setter Property="Foreground" Value="#EFF7F5" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top"
                BorderBrush="#24373A"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,20"
                Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Classes="kicker" Text="DVM // DISPATCH" />
                    <TextBlock Classes="title" Text="{Binding ProductName}" />
                    <TextBlock Classes="muted" Text="Operator console · Avalonia frontend" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <Border Background="#302718"
                            BorderBrush="#735E2E"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,7"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#F3B562" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionLabel}"
                                       FontSize="12"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="muted"
                               Text="{Binding ConnectionDetail}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="#24373A"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0"
                Margin="0,20,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="kicker" Text="RUNTIME NOTE" />
                    <TextBlock Classes="muted"
                               Text="Protocol, modem, and native audio services attach when the host supports them; unavailable capabilities stay gated." />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Classes="muted"
                           Text="macOS migration · managed shell gate"
                           VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="220,16,*">
            <Border Grid.Column="0" Classes="panel" Padding="18">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock Classes="kicker" Text="SYSTEM" />
                        <TextBlock Classes="data-value" Text="FNE connections" />
                    </StackPanel>

                    <TextBlock Classes="muted"
                               Text="No systems configured"
                               IsVisible="{Binding FneConnections.HasNoSystems}" />

                    <ItemsControl ItemsSource="{Binding FneConnections.Systems}"
                                  IsVisible="{Binding FneConnections.HasSystems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FneSystemConnectionViewModel">
                                <Border Background="#182326"
                                        BorderBrush="#31484A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="data-value" Text="{Binding SystemName}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="muted"
                                                       Text="{Binding StatusText}" />
                                        </Grid>
                                        <TextBlock Classes="muted" Text="{Binding Endpoint}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{Binding ToggleButtonText}"
                                                    IsEnabled="{Binding ButtonsEnabled}"
                                                    Click="FneStartStop_Click" />
                                            <Button Content="Restart"
                                                    IsEnabled="{Binding ButtonsEnabled}"
                                                    Click="FneRestart_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="data-label" Text="CAPABILITIES" />
                        <TextBlock Classes="muted" Text="• Native audio device routing" />
                        <TextBlock Classes="muted"
                                   Text="{Binding VocoderStatus}"
                                   IsVisible="{Binding VocoderStatus, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="muted" Text="• Global hotkey fallback ready" />
                        <TextBlock Classes="muted" Text="• File dialogs available" />
                    </StackPanel>

                    <TextBlock Classes="muted"
                               Text="{Binding TarViewerStatusMessage}"
                               IsVisible="{Binding TarViewerStatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="kicker" Text="CHANNEL GRID" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Operator slots" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Classes="muted"
                               Text="{Binding SelectedZone.Name}"
                               VerticalAlignment="Bottom" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                    <ComboBox ItemsSource="{Binding Zones}"
                              SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                              HorizontalAlignment="Left"
                              MinWidth="280">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ZoneViewModel">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="SELECT / CLEAR ALL"
                            Click="SelectAllChannels_Click" />
                </StackPanel>

                <Border Grid.Row="2" Classes="panel" Padding="14">
                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelSlotViewModel">
                                <Border Classes="channel-card"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.primary="{Binding IsPrimary}"
                                        PointerPressed="ChannelCard_PointerPressed"
                                        Width="{Binding CardWidth}"
                                        Height="{Binding CardHeight}"
                                        ClipToBounds="True"
                                        Background="{Binding IdleBrush}"
                                        Margin="0,0,12,12"
                                        Padding="14">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="kicker" Text="{Binding Label}" />
                                            <Ellipse Grid.Column="1"
                                                     Classes="activity"
                                                     Classes.receiving="{Binding IsReceiving}"
                                                     Classes.encrypted="{Binding IsReceivingEncrypted}"
                                                     Width="8" Height="8"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="data-label" Text="CHANNEL" />
                                            <TextBlock Classes="data-value" Text="{Binding ChannelName}"
                                                       IsVisible="{Binding ChannelName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="data-label" Text="MODE" />
                                                <TextBlock Classes="data-value" Text="{Binding ChannelMode}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Classes="data-label" Text="SYSTEM" />
                                                <TextBlock Classes="data-value" Text="{Binding SystemName}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="data-label" Text="TALKGROUP" />
                                            <TextBlock Classes="data-value" Text="{Binding Talkgroup}" />
                                        </StackPanel>
                                        <TextBlock Classes="muted" Text="{Binding LastSrcId}" />
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="data-label" Text="OUTPUT" />
                                            <ComboBox ItemsSource="{Binding MonitorOutputDevices}"
                                                      SelectedItem="{Binding MonitorOutputDevice, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AudioDeviceOptionViewModel">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="data-label" Text="VOLUME" />
                                            <Slider Minimum="0"
                                                    Maximum="4"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="False"
                                                    Value="{Binding Volume, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock Classes="muted"
                                                   Text="RX ACTIVE"
                                                   IsVisible="{Binding IsReceiving}" />
                                        <TextBlock Classes="muted"
                                                   Text="TX ACTIVE"
                                                   IsVisible="{Binding PttEngaged}" />
                                        <TextBlock Classes="muted"
                                                   Text="TX ENCRYPTED"
                                                   IsVisible="{Binding IsTxEncrypted}" />
                                        <TextBlock Classes="muted"
                                                   Text="{Binding FneConnectionWarningToolTip}"
                                                   IsVisible="{Binding FneConnectionWarningVisible}" />
                                        <TextBlock Classes="muted"
                                                   Text="RX ONLY"
                                                   IsVisible="{Binding IsRxOnly}" />
                                        <TextBlock Classes="muted" Text="{Binding Status}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid Grid.Row="3" ColumnDefinitions="*,16,*,16,*">
                    <Border Classes="panel" Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="kicker" Text="AUDIO PATH" />

                            <StackPanel Spacing="10"
                                        IsVisible="{Binding AudioSettings, Converter={x:Static conv:ObjectConverters.IsNull}}">
                                <TextBlock Classes="data-value" Text="Audio devices unavailable" />
                                <TextBlock Classes="muted"
                                           Text="This session has no audio device catalog; CoreAudio enumeration attaches with the macOS backend gate." />
                            </StackPanel>

                            <StackPanel Spacing="12"
                                        IsVisible="{Binding AudioSettings, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="data-label" Text="CAPTURE" />
                                    <ComboBox x:Name="AudioInputComboBox"
                                              ItemsSource="{Binding AudioSettings.InputDevices}"
                                              SelectionChanged="AudioInputComboBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AudioDeviceOptionViewModel">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="data-label" Text="PLAYBACK" />
                                    <ComboBox x:Name="AudioOutputComboBox"
                                              ItemsSource="{Binding AudioSettings.OutputDevices}"
                                              SelectionChanged="AudioOutputComboBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AudioDeviceOptionViewModel">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="data-label"
                                               Text="AUTO GAIN CONTROL"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding AudioSettings.AgcEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Classes="muted"
                                           Text="Selection changes are session state; Save raises a request only and persists nothing yet." />

                                <Button Content="Save"
                                        HorizontalAlignment="Right"
                                        Click="AudioSave_Click" />

                                <TextBlock Classes="muted"
                                           Text="{Binding AudioSaveFeedback}"
                                           IsVisible="{Binding AudioSaveFeedback, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="panel" Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="kicker" Text="CALL HISTORY" />

                            <StackPanel Spacing="10"
                                        IsVisible="{Binding CallHistory, Converter={x:Static conv:ObjectConverters.IsNull}}">
                                <TextBlock Classes="data-value" Text="Call history not attached" />
                                <TextBlock Classes="muted"
                                           Text="No call-history store is composed for this session; received calls are not recorded." />
                            </StackPanel>

                            <StackPanel Spacing="12"
                                        IsVisible="{Binding CallHistory, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                <Grid ColumnDefinitions="78,*,*,62,62">
                                    <TextBlock Classes="data-label" Text="TIMESTAMP" />
                                    <TextBlock Grid.Column="1" Classes="data-label" Text="CHANNEL" />
                                    <TextBlock Grid.Column="2" Classes="data-label" Text="RID ALIAS" />
                                    <TextBlock Grid.Column="3" Classes="data-label" Text="RID" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Classes="data-label" Text="TGID" TextAlignment="Right" />
                                </Grid>

                                <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding CallHistory.Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="svc:CallHistoryEntry">
                                                <Grid ColumnDefinitions="78,*,*,62,62" Margin="0,3,0,3">
                                                    <TextBlock Classes="muted" FontSize="11"
                                                               Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                                    <TextBlock Grid.Column="1" Classes="data-value" FontSize="12"
                                                               Text="{Binding ChannelName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Classes="muted" FontSize="11"
                                                               Text="{Binding Alias}" />
                                                    <TextBlock Grid.Column="3" Classes="muted" FontSize="11"
                                                               Text="{Binding SrcId}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Classes="muted" FontSize="11"
                                                               Text="{Binding DstId}" TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Classes="muted"
                                           Text="One entry per call stream; received calls record automatically." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Classes="panel" Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="kicker" Text="PTT CAPABILITY" />

                            <StackPanel Spacing="10"
                                        IsVisible="{Binding Ptt, Converter={x:Static conv:ObjectConverters.IsNull}}">
                                <TextBlock Classes="data-value" Text="Global hotkey capability not attached" />
                                <TextBlock Classes="muted"
                                           Text="No global hotkey service is composed for this session; PTT engagement attaches with the macOS hotkey backend gate." />
                            </StackPanel>

                            <StackPanel Spacing="12"
                                        IsVisible="{Binding Ptt, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="data-label" Text="HOTKEY" />
                                    <TextBlock Classes="data-value" Text="{Binding Ptt.Hotkey}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="data-label" Text="CAPABILITY" />
                                    <TextBlock Classes="data-value" Text="{Binding Ptt.Capability}" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="data-label"
                                               Text="TOGGLE MODE"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding Ptt.ToggleMode, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="data-label"
                                               Text="ALL CHANNELS"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding Ptt.AllChannels, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="data-label" Text="ENGAGEMENT" />
                                    <TextBlock Classes="data-value" Text="{Binding Ptt.IsEngaged}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="data-label" Text="CAPTURE" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Set hotkey"
                                                Click="HotkeyCapture_Start_Click" />
                                        <Button Content="Clear"
                                                Click="HotkeyCapture_Clear_Click" />
                                        <Button Content="Cancel"
                                                Click="HotkeyCapture_Cancel_Click"
                                                IsVisible="{Binding HotkeyCapture.IsCapturing}" />
                                    </StackPanel>
                                    <TextBlock Classes="muted"
                                               Text="Press a key combination while capture is active."
                                               IsVisible="{Binding HotkeyCapture.IsCapturing}" />
                                </StackPanel>

                                <Button Classes="ptt-button"
                                        Classes.engaged="{Binding Ptt.IsEngaged}"
                                        Content="PUSH TO TALK"
                                        PointerPressed="PttButton_PointerPressed"
                                        PointerReleased="PttButton_PointerReleased"
                                        PointerCaptureLost="PttButton_PointerCaptureLost" />

                                <TextBlock Classes="muted"
                                           Text="Hotkey events are routed on the UI thread; registration attaches with the macOS backend gate." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
