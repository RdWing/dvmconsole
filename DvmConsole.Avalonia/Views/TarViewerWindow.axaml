<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DvmConsole.Avalonia.ViewModels"
        xmlns:conv="using:DvmConsole.Avalonia.Converters"
        x:Class="DvmConsole.Avalonia.Views.TarViewerWindow"
        x:ClassModifier="internal"
        x:DataType="vm:TarViewerViewModel"
        Title="TAR Viewer"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        Background="#0B1114"
        Foreground="#EFF7F5"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:DateTimeFilterConverter x:Key="DateTimeFilterConverter" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#8EA3A3" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#8EA3A3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#111B1F" />
            <Setter Property="BorderBrush" Value="#24373A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Background" Value="#1A262B" />
            <Setter Property="BorderBrush" Value="#2A4548" />
            <Setter Property="Foreground" Value="#EFF7F5" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="22">
        <Border DockPanel.Dock="Top"
                Classes="panel"
                Padding="18"
                Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="TAR // RECORDINGS"
                               Foreground="#5FE1D2"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="TAR Viewer"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Classes="muted"
                               Text="Search, review, play, reveal, and remove persisted recordings." />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="action"
                        Content="Columns"
                        Click="ColumnsButton_Click"
                        VerticalAlignment="Center">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="TimeColumnMenuItem" Header="Time" Tag="Time" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                            <MenuItem x:Name="DurationColumnMenuItem" Header="Duration" Tag="Duration" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                            <MenuItem x:Name="ChannelColumnMenuItem" Header="Channel" Tag="Channel" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                            <MenuItem x:Name="TalkgroupColumnMenuItem" Header="Talkgroup" Tag="Talkgroup" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                            <MenuItem x:Name="SourceIdColumnMenuItem" Header="Source ID" Tag="SourceId" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                            <MenuItem x:Name="AliasColumnMenuItem" Header="Alias" Tag="Alias" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="DirectionColumnMenuItem" Header="Direction" Tag="Direction" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                            <MenuItem x:Name="ProtocolColumnMenuItem" Header="Protocol" Tag="Protocol" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                            <MenuItem x:Name="SystemColumnMenuItem" Header="System" Tag="System" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                            <MenuItem x:Name="EncryptionColumnMenuItem" Header="Encryption" Tag="Encryption" ToggleType="CheckBox" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="2"
                        Classes="action"
                        Content="Close"
                        Click="Close_Click"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Classes="panel"
                Padding="14"
                Margin="0,14,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusTextBlock"
                           Classes="muted"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Classes="action" Content="Refresh" Click="Refresh_Click" />
                    <Button Classes="action" Content="Play" Click="Play_Click" />
                    <Button Classes="action" Content="Stop" Click="Stop_Click" />
                    <Button Classes="action" Content="Open Folder" Click="OpenFolder_Click" />
                    <Button Classes="action" Content="Delete" Click="Delete_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Classes="panel"
                Padding="14"
                Margin="0,0,0,14">
            <Grid ColumnDefinitions="2*,*,*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="10">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="SEARCH" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="All fields" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                    <TextBlock Classes="label" Text="DIRECTION" />
                    <ComboBox ItemsSource="{Binding DirectionFilters}"
                              SelectedItem="{Binding SelectedDirectionFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                    <TextBlock Classes="label" Text="PROTOCOL" />
                    <ComboBox ItemsSource="{Binding ProtocolFilters}"
                              SelectedItem="{Binding SelectedProtocolFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Spacing="4">
                    <TextBlock Classes="label" Text="ENCRYPTION" />
                    <ComboBox ItemsSource="{Binding EncryptionFilters}"
                              SelectedItem="{Binding SelectedEncryptionFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="SYSTEM" />
                    <TextBox Text="{Binding SystemFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock Classes="label" Text="CHANNEL" />
                    <TextBox Text="{Binding ChannelFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                    <TextBlock Classes="label" Text="TALKGROUP" />
                    <TextBox Text="{Binding TalkgroupFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Spacing="4">
                    <TextBlock Classes="label" Text="SUBSCRIBER" />
                    <TextBox Text="{Binding SourceIdFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="ALIAS" />
                    <TextBox Text="{Binding AliasFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                    <TextBlock Classes="label" Text="START DATE" />
                    <DatePicker SelectedDate="{Binding StartDateFilter, Mode=TwoWay, Converter={StaticResource DateTimeFilterConverter}, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                    <TextBlock Classes="label" Text="END DATE" />
                    <DatePicker SelectedDate="{Binding EndDateFilter, Mode=TwoWay, Converter={StaticResource DateTimeFilterConverter}, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Grid.Row="2"
                        Grid.Column="3"
                        Classes="action"
                        Content="Clear Filters"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Click="ClearFilters_Click" />
            </Grid>
        </Border>

        <Border Classes="panel" Padding="1">
            <StackPanel>
                <Border Background="#142126"
                        Padding="10,8"
                        BorderBrush="#24373A"
                        BorderThickness="0,0,0,1">
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TarViewerColumnDescriptor">
                                <TextBlock Text="{Binding Header}"
                                           Width="{Binding Width}"
                                           IsVisible="{Binding IsVisible}"
                                           Classes="label" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ListBox x:Name="RecordingsList"
                         ItemsSource="{Binding Rows}"
                         SelectionChanged="RecordingsList_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TarViewerViewModel+TarRecordingListItem">
                            <Border Padding="10,8"
                                    BorderBrush="#24373A"
                                    BorderThickness="0,0,0,1">
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TarViewerViewModel+TarViewerCell">
                                            <TextBlock Text="{Binding Value}"
                                                       Width="{Binding Column.Width}"
                                                       IsVisible="{Binding Column.IsVisible}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
